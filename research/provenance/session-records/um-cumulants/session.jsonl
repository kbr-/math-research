{"event": "run_start", "monotonic_s": 84106.732397392, "unix_s": 1792226585.6738915, "id": "e6781c2c3b", "category": "computation", "command": ["python3", "-c", "\nimport re,glob\nLS=r'^[ \\t#/*;%\"\\'-]*'\nOLD=r'[ \\t]*(?:\\S+[ \\t]+){4,}\\S+'\nSEP=r'(?:[ \\t]+|[ \\t]*\\n[ \\t#/*;%\"\\'-]*(?![A-Z][\\w ,()-]{0,40}:)(?=\\S))'\nNEW=r'[ \\t]*(?:\\S+'+SEP+r'){4,}\\S+'\nlabels=['Refuted by:','Possible because:','No statement tested:','Decisive at these sizes:','Parallel use:','Positive control:','Baseline:','Record checked:','Forced by counts:']\nfiles=[f for e in ('py','gp','m2','sing','g') for f in glob.glob('research/results/**/*.'+e,recursive=True)]\ntot={l:[0,0,0] for l in labels}; gained=[]\nfor f in files:\n    head=''.join(open(f,errors='replace').readlines()[:150])\n    for l in labels:\n        o=bool(re.search(LS+re.escape(l)+OLD,head,re.M)); n=bool(re.search(LS+re.escape(l)+NEW,head,re.M))\n        tot[l][0]+=o; tot[l][1]+=n\n        if o and not n: tot[l][2]+=1\n        if n and not o: gained.append((f,l))\nprint(len(files),'scripts read')\nfor l,(o,n,lost) in tot.items(): print(f'{l:28s} old {o:5d} new {n:5d} lost {lost}')\nprint(len(gained),'newly accepted:')\nfor f,l in gained: print(' ',l,f)\n"], "output": "logs/um-cumulants-e6781c2c3b.output.txt", "cwd": "/home/kbr/dev/math/.claude/worktrees/talagrand", "systemd_unit": "mathcompute-job-a799f31afacb4a829675549279d0aae5.service", "threads": 1, "timeout_s": 120.0, "expect_s": null, "serial_reason": "", "kernel_reason": "", "user_approved": ""}
