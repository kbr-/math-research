// Route-review test: the plane4 family (four blocks on the lines of F_3^2, h = 3, two shared inputs and one private
// input p(j) each, private coefficients, separately augmented) has a degree-9 consequence outside the three-local ideal
// (three_local_inclusion_checked.out).  Prints that generator and its factorization, and checks whether it is a
// multiple of the private-input product, as a none-indicator combination Y (sum c_a P_a - g) would be
// (lem:none-indicator-identity).
// With explicit degree checks (the truncated Bayer lemma needs every used basis element of degree <= 11).
// Corrected form of conj:three-local-augmentation (after self_aug_control.out showed that augmenting even by the
// family's own degree-11 consequences leaves falls at 9, so "no fall after augmentation" is the wrong formulation):
// every consequence the four-block family derives within degree 11 lies in the ideal generated by J_F and the
// consequences its three-block subfamilies derive within degree 11.  Counts the family consequences outside that ideal.
// Three-local joint augmentation test (the natural general form of open statement S2): for a four-block family of
// separately augmented complete accuracy-one ENS blocks over F_3 with private coefficients, h = 3 inputs (two shared,
// one private), add for every subfamily T of three blocks all of T's consequences derivable within degree 11
// (S_T in degree s = elements f with z^(11-s) f in J_T), then compute the family's lowest fall below 11.
// This version uses slimgb for every basis and degree bound 11 for both families.
// three_local_db9_slim.out: at degree bound 9 the cycle family still falls at 8 after three-local augmentation.
// It used degree bound 9 (consequences derivable within degree 9, falls at degree <= 8 visible).
// Question decided: does jointly augmenting every subfamily of at most three blocks remove every fall of the family
// below 11?  A remaining fall means a four-block phenomenon, so members must grow beyond three blocks.
// Families:  cycle:  a (x, y), b (x+y, w), c (w, v), d (v, x-y)
//            plane4: a (x, y), b (x+y, x-y), c (x, x+y), d (y, x-y)
// Output: the family's lowest fall after three-local augmentation (three_local_timeout.out: the cycle family's own
// lowest fall without cross generators is 7).
option(redSB);
int DBG = 11;  // degree bound 11, the compiler degree: falls at degree <= 10 visible
system("--ticks-per-sec", 1); int t0 = rtimer;
proc blockideal(ideal L, ideal rr)
{
  poly P = 1; int i; for (i = 1; i <= 3; i++) { P = P - rr[i]*(1 - L[i]^2); }
  ideal I; for (i = 1; i <= 3; i++) { I = I, (1 - L[i]^2)*P; }
  return(I);
}
proc lowestfall(ideal J, int DB)
{
  // Lowest fall below DB without a second standard basis: by Bayer's theorem (dp, z last), (J : z) is generated by
  // J and g/z for the standard basis elements g divisible by z; the least degree of such a g/z not in J is the fall.
  degBound = DB; ideal SJ = slimgb(J); degBound = 0;
  int lowest = DB; int k; poly g;
  for (k = 1; k <= ncols(SJ); k++) {
    g = SJ[k];
    if (g != 0 && subst(g, z, 0) == 0) { g = g / z; if (deg(g) < lowest) { if (reduce(g, SJ) != 0) { lowest = deg(g); } } }
  }
  return(lowest);
}
proc derivable(ideal J, int DB)
{
  // Consequences derivable within degree DB: by Bayer's theorem, for dp (degree reverse lexicographic) with z the
  // last variable, dividing each element of a degree-DB-truncated standard basis by its highest power of z gives
  // generators of all f with z^m f in J_(<= DB).  One standard basis instead of one colon per degree.
  degBound = DB; ideal SJ = slimgb(J); degBound = 0;
  ideal S; int k; poly g; int m; int over = 0; int maxd = 0;
  for (k = 1; k <= ncols(SJ); k++) {
    if (SJ[k] != 0 && deg(SJ[k]) > maxd) { maxd = deg(SJ[k]); }
    if (SJ[k] != 0 && deg(SJ[k]) > DB) { over++; continue; }
    g = SJ[k]; m = 0;
    while (g != 0 && subst(g, z, 0) == 0) { g = g / z; m++; }
    if (m > 0) { S = S, g; }
  }
  print("  triple basis: max degree " + string(maxd) + ", elements above the bound skipped: " + string(over));
  return(S);
}
proc runfamily(int kind)
{
  ring S = 3, (x, y, w, v, p(1..4), r(1..12), z), dp;
  list L;
  if (kind == 1) { L = ideal(x, y, p(1)), ideal(x + y, w, p(2)), ideal(w, v, p(3)), ideal(v, x - y, p(4)); }
  else { L = ideal(x, y, p(1)), ideal(x + y, x - y, p(2)), ideal(x, x + y, p(3)), ideal(y, x - y, p(4)); }
  ideal F; int i; for (i = 1; i <= nvars(basering) - 1; i++) { F = F, var(i)^3 - var(i); }
  list G; ideal rr; int j;
  for (j = 1; j <= 4; j++) { rr = r(3*j-2), r(3*j-1), r(3*j); G = G + list(homog(std(blockideal(L[j], rr) + F), z)); }
  ideal J = homog(F, z) + G[1] + G[2] + G[3] + G[4];
  string nm = "cycle"; if (kind == 2) { nm = "plane4"; }
  degBound = DBG; ideal SJ = slimgb(J); degBound = 0;
  print(nm + " family standard basis: " + string(ncols(SJ)) + " elements, " + string(rtimer - t0) + " s");
  ideal New; int a; ideal JT; ideal ST; int k; poly f;
  for (a = 1; a <= 4; a++) {
    JT = homog(F, z);
    for (j = 1; j <= 4; j++) { if (j != a) { JT = JT + G[j]; } }
    ST = derivable(JT, DBG);
    New = New + simplify(reduce(ST, SJ), 2);  // one batch reduction, zeros dropped
    print(nm + " triple without block " + string(a) + ": " + string(ncols(ST)) + " derivable, running total of " + string(size(simplify(New, 2))) + " not in the family ideal, " + string(rtimer - t0) + " s");
  }
  // Inclusion test: every consequence of the whole family derivable within degree DBG (Bayer, from SJ) must lie in
  // the ideal generated by J_F and the triples' consequences.  Count those that do not reduce to 0.
  degBound = DBG; ideal SA = slimgb(SJ + New); degBound = 0;
  print(nm + " three-local augmented basis: " + string(ncols(SA)) + " elements, " + string(rtimer - t0) + " s");
  ideal SF; poly g;
  int overF = 0; int maxF = 0; list src;
  for (k = 1; k <= ncols(SJ); k++) {
    if (SJ[k] != 0 && deg(SJ[k]) > maxF) { maxF = deg(SJ[k]); }
    if (SJ[k] != 0 && deg(SJ[k]) > DBG) { overF++; continue; }
    g = SJ[k]; if (g != 0 && subst(g, z, 0) == 0) { while (subst(g, z, 0) == 0) { g = g / z; } SF = SF, g; src = src + list(deg(SJ[k])); }
  }
  print(nm + " family basis: max degree " + string(maxF) + ", elements above the bound skipped: " + string(overF));
  ideal RemAll = reduce(SF, SA); ideal Rem = simplify(RemAll, 2);
  for (k = 1; k <= ncols(RemAll); k++) { if (RemAll[k] != 0) {
    print(nm + " outside: generator of degree " + string(deg(SF[k])) + " from a basis element of degree " + string(src[k]));
    poly o = subst(SF[k], z, 1);
    print("  outside element (z = 1), " + string(size(o)) + " terms: " + string(o));
    print("  factors: " + string(factorize(o, 1)));
    // None-indicator test: does o lie in the span of Y * (P_a, P_b, P_c, P_d, and quadratics in the shared forms)
    // modulo J_F?  Here Y = p(1) p(2) p(3) p(4), the product of the private inputs.
    poly Yp = p(1)*p(2)*p(3)*p(4);
    print("  divisible by all private inputs: " + string(reduce(o, std(ideal(Yp))) == 0));
    kill o; kill Yp;
  } }
  int lowest = DBG; for (k = 1; k <= ncols(Rem); k++) { if (Rem[k] != 0 && deg(Rem[k]) < lowest) { lowest = deg(Rem[k]); } }
  print(nm + " family consequences within degree " + string(DBG) + ": " + string(size(simplify(SF, 2))) + "; not in the three-local ideal: " + string(size(Rem)) + " (least degree " + string(lowest) + ", " + string(DBG) + " meaning none)");
  print(nm + " done, " + string(rtimer - t0) + " s");
}
runfamily(2);
quit;
