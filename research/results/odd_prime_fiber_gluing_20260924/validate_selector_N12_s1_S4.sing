ring O = 3, (c(1..12), z), dp;
option(redSB);
ideal I = c(1)^2-c(1), c(2)^2-c(2), c(3)^2-c(3), c(4)^2-c(4), c(5)^2-c(5), c(6)^2-c(6), c(7)^2-c(7), c(8)^2-c(8), c(9)^2-c(9), c(10)^2-c(10), c(11)^2-c(11), c(12)^2-c(12), c(1)+c(2)+c(3)+c(4)+c(5)+c(6)+c(7)+c(8)+c(9)+c(10)+c(11)+c(12)-12, (1-((1*c(1)+1*c(2)+2*c(3)+1*c(4)+2*c(5)+2*c(6)+2*c(7)+2*c(8)+1*c(9)+1*c(10)+2*c(11)+1*c(12))-1)^2);
ideal H = homog(std(I), z);
H = sat(H, z)[1];
H = subst(H, c(5), z);
degBound = 5;
ideal GB = std(H);
ideal GA = std(H + ideal(z));
string sb = "HFB {"; string sa = "HFA {"; int t;
for (t = 0; t <= 5; t++) { if (t > 0) { sb = sb + ","; sa = sa + ","; } ideal gb = GB; ideal ga = GA;
sb = sb + string(size(kbase(std(GB + ideal(c(5))), t)));
sa = sa + string(size(kbase(std(GA + ideal(c(5))), t))); }
print(sb + "}"); print(sa + "}");
quit;
