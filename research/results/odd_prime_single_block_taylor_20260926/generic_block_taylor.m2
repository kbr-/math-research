-- Generic single-block randomized Taylor generation (thm:randomized-taylor-glue).
-- In the freeness range G is free over T = F_3[y_1..y_h]/(y_i^3) (y_i -> l_i), so the degree-s
-- top syzygies of one block over G are those over T tensored up. Statement tested: the syzygy
-- module of tau_i = y_i^2 * prod_j q_j^2 (q_j = sum_k c_jk y_k^2) over T is generated by
-- (F1) y_i e_i, (F2) q_j e_i, (K1) y_k^2 e_i - y_i^2 e_k. Reports, for each case, the degrees
-- multiplier degrees (generators of T^h sit in degree 0) where kernel / generated submodule is nonzero, with its
-- Hilbert function. Controls: plain squares (t = 0, tops y_i^2) and a degenerate prefix.
kk = ZZ/3;
out = openOut getenv "GBT_OUT";
report = (label, h, cs) -> (
    T := kk[y_1..y_h] / ideal apply(h, i -> (y_(i+1))^3);
    Y := gens T;
    t := #cs;
    qs := apply(cs, c -> sum(h, k -> c#k * (Y#k)^2));
    Phi := product(qs, q -> q^2);
    taus := apply(Y, v -> v^2 * Phi);
    F := T^h;
    phi := map(T^1, F, matrix{taus});
    K := kernel phi;
    e := i -> (id_F)_{i};
    gl := apply(h, i -> Y#i * e(i));
    gl = gl | flatten apply(qs, q -> apply(h, i -> q * e(i)));
    gl = gl | flatten flatten apply(h, i -> apply(toList(i+1..h-1), k -> (Y#k)^2 * e(i) - (Y#i)^2 * e(k)));
    if getenv "GBT_F3" == "1" then gl = gl | apply(cs, c -> sum(h, k -> c#k * e(k)));
    Gen := image fold((a, b) -> a | b, gl);
    Q := (image generators K) / Gen;
    hf := apply(toList(0..2*h), d -> hilbertFunction(d, Q));
    shift := 4 * t + 2;
    bad := select(toList(0..2*h), d -> hf#d != 0);
    out << label << " h=" << h << " t=" << t << " c=" << toString(apply(cs, c -> apply(c, a -> lift(a, ZZ))))
        << " topsNonzero=" << toString(apply(taus, tt -> tt != 0))
        << " quotientDegrees(s)=" << toString(apply(bad, d -> d)) << " dims=" << toString(apply(bad, d -> hf#d)) << endl;
    out << flush);
-- note: module degrees above are the degrees of the multiplier component plus the generator degree
setRandomSeed 20260926;
for h from 2 to 6 do (
    report("squares", h, {});
    for trial from 1 to 3 do report("random t=1", h, {apply(h, k -> random kk)});
    report("all-ones t=1", h, {apply(h, k -> 1_kk)});
    report("degenerate t=1", h, {apply(h, k -> if k == 0 then 1_kk else 0_kk)}));
for h from 3 to 6 do for trial from 1 to 2 do report("random t=2", h, {apply(h, k -> random kk), apply(h, k -> random kk)});
close out;
