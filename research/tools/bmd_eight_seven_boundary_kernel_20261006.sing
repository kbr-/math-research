// Actual p7,D0mod7 first conic source:13 complete cuts, N1mod7,M3mod7,M2mod4.
ring rr=(7,u),(t,c,x,y),dp;
proc vv(int j){int k=((j%4)+4)%4;if(k==0){return(x);}if(k==1){return(y);}if(k==2){return(-x);}return(-y);}
proc hl(int r,int j,int sg){
 poly p=0;int k=r-12+j;if(k==0){p=1;}if(k==1){p=-u;}
 k=r-j;if(k==0){p=p+sg*c;}if(k==1){p=p-sg*c/u;}return(p);
}
proc assess_template(matrix Stored,int pp,int d,int smallestN,int period,poly lx,poly ly){
 if(d!=10){return();}
 matrix B[13][13];int j;
 for(j=0;j<=12;j++){
  B[1,j+1]=j-2+(3-j)*u;B[2,j+1]=(-1)^j*(j-2+(j-3)*u);
  B[3,j+1]=vv(j);B[4,j+1]=((j-3)*(u^2+1)+1)*vv(j-1)-u*vv(j);
  B[5,j+1]=hl(3,j,1)-hl(1,j,1);B[6,j+1]=hl(5,j,1)-3*hl(1,j,1);
  B[7,j+1]=hl(0,j,1);B[8,j+1]=hl(4,j,1);B[9,j+1]=hl(6,j,1)-3*hl(2,j,1);
  B[10,j+1]=hl(3,j,-1)-2*hl(1,j,-1);B[11,j+1]=hl(5,j,-1)-hl(1,j,-1);
  B[12,j+1]=hl(2,j,-1)-3*hl(0,j,-1);B[13,j+1]=hl(4,j,-1)-3*hl(0,j,-1);
 }
 int i;number scale;
 for(i=1;i<=13;i++){scale=u;if(i>=5 && i<=9){scale=-u;}if(i<=4 || i==7){scale=1;}for(j=1;j<=13;j++){if(Stored[i,j]!=scale*B[i,j]){ERROR("raw/stored cut mismatch");return();}}}
 poly Q=(1-u*t)*(1+t^2)^2*(u+c*t^7);matrix Qv[13][1];
 for(j=0;j<=12;j++){Qv[j+1,1]=subst(Q/t^j,t,0);}
 if(size(ideal(B*Qv))!=0){ERROR("explicit full-source kernel");return();}
 if(Qv[1,1]!=u){ERROR("kernel constant coordinate");return();}
 matrix Minor[12][12];matrix LL[1][13];int ri;int cj;
 for(i=1;i<=13;i++){
  for(ri=1;ri<=12;ri++){for(cj=1;cj<=12;cj++){Minor[ri,cj]=B[ri+(ri>=i),cj+1];}}
  LL[1,i]=(-1)^(i+1)*det(Minor);
 }
 poly lg=0;for(i=1;i<=13;i++){lg=gcd(lg,LL[1,i]);}
 if(lg==0){ERROR("no rank12 cofactor");return();}
 print("EXPLICIT_KERNEL=");print(Q);print("LEFT_COMMON_FACTOR=");print(factorize(lg));
 for(i=1;i<=13;i++){
  list dv=division(LL[1,i],lg);poly quot=dv[1][1,1];if(quot*lg!=LL[1,i]){ERROR("exact left normalization");return();}LL[1,i]=quot;
 }
 if(size(ideal(LL*B))!=0){ERROR("exact left kernel");return();}
 print("LEFT_KERNEL=");print(LL);
 // The row1,column1 cofactor is a convenient actual-rank candidate.
 for(ri=1;ri<=12;ri++){for(cj=1;cj<=12;cj++){Minor[ri,cj]=B[ri+1,cj+1];}}
 print("FIRST_MINOR=");print(factorize(det(Minor)));
 string out="research/results/bmd-eight-septenary-variation-20261006/boundary-data.sing";
 write(out,"matrix Boundary[13][13];");for(i=1;i<=13;i++){for(j=1;j<=13;j++){if(B[i,j]!=0){write(out,"Boundary["+string(i)+","+string(j)+"]="+string(B[i,j])+";");}}}
 write(out,"matrix LeftKernel[1][13];");for(i=1;i<=13;i++){write(out,"LeftKernel[1,"+string(i)+"]="+string(LL[1,i])+";");}
 write(out,"poly Kernel=(1-u*t)*(1+t^2)^2*(u+c*t^7);");
 write(out,"poly CofactorFactor="+string(lg)+";");
 print("PASS full-source right kernel, nonzero formal rank12 cofactor, exact left kernel and stored-cut comparison.");
}
execute(read("research/results/bmd-eight-small-prime-source-20261006/matrices-p7.sing"));
quit;
