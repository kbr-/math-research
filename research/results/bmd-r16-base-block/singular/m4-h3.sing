option(redSB);
ring r = 2, (y1, y2, B), dp;
module N = [1, 0, 0, 0, 0], [0, y2^1, y2^2, 0, y2^4*B^1], [0, 0, y2^2, 0, y2^4], [0, y1^1, y1^2, 0, y1^4*B^1], [0, 0, y1^1*y2^1, y1^1*y2^2+y1^2*y2^1, y1^2*y2^2], [0, 0, y1^2, 0, y1^4];
matrix A = transpose(matrix(N, 5, ncols(N)));
module Z = syz(A);
int i; int j; int found = 0;
for (i = 1; i <= ncols(Z); i++) { if (found == 0 && Z[i][5] == 1) {
  found = 1; for (j = 1; j <= 5; j++) { print("EXIST " + string(j - 1) + " " + string(Z[i][j])); } } }
module E = gen(5);
module I = intersect(N, E);
for (i = 1; i <= ncols(I); i++) { if (found == 0 && I[i][5] != 0 && diff(I[i][5], B) == 0) {
  found = 2; print("NONEX " + string(I[i][5]));
  matrix T = lift(N, module(I[i]));
  for (j = 1; j <= nrows(T); j++) { print("LAMBDA " + string(j - 1) + " " + string(T[j, 1])); } } }
if (found == 0) { print("NONE"); }
quit;
