F3[7,13]=bc(4,8)*(-u)^(8)+(-1)*C*bc(4,0)*(-u)^(-0);
F3[7,14]=bc(4,9)*(-u)^(9);
F3[7,15]=bc(4,10)*(-u)^(10);
F3[7,16]=bc(4,11)*(-u)^(11);
F3[7,17]=bc(4,12)*(-u)^(12);
W=0;for(k=0;k<=7;k++){W=W+bc(3,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=17;j++){R[1,j]=F3[1,j];}
for(h=1;h<=7;h++){cf=subst(W/t^(h-1),t,0);for(j=1;j<=17;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=7;k++){W=W+bc(2,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=17;j++){R[1,j]=F3[2,j];}
for(h=2;h<=7;h++){cf=subst(W/t^(h-2),t,0);for(j=1;j<=17;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=7;k++){W=W+bc(1,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=17;j++){R[1,j]=F3[3,j];}
for(h=3;h<=7;h++){cf=subst(W/t^(h-3),t,0);for(j=1;j<=17;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=7;k++){W=W+bc(0,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=17;j++){R[1,j]=F3[4,j];}
for(h=4;h<=7;h++){cf=subst(W/t^(h-4),t,0);for(j=1;j<=17;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
for(j=1;j<=17;j++){D[15,j]=F3[5,j];}
for(j=1;j<=17;j++){D[16,j]=F3[6,j];}
for(j=1;j<=17;j++){D[17,j]=F3[7,j];}
print("dimension=17; maximum high depth=12");
poly detD=det(D);
poly AA=(1)*u^0+(-6)*u^2+(1)*u^4;poly BB=(4)*u^1+(-4)*u^3;poly GG=(1)*u^0+(6)*u^2+(1)*u^4;poly HH=(-4)*u^1+(-4)*u^3;
map shift=rr,t,u^(4)*C,(AA*X+BB*Y)/(1),(AA*Y-BB*X)/(1),(GG*U+HH*V)/(1),(HH*U+GG*V)/(1);
detD=shift(detD);
print("case minus1over2");

if(detD==0){ERROR("zero determinant");}
list fac=factorize(detD);
poly product=1;int ff;
for(ff=1;ff<=size(fac[1]);ff++){product=product*fac[1][ff]^fac[2][ff];}
if(product!=detD){ERROR("factor product mismatch");}
map atPowerOrigin=rr,t,0,2,0,2,0;
poly oneFactor;poly value;string encoded;string decoded;
ring integral=integer,(u,t,C,X,Y,U,V),dp;
setring rr;
for(ff=2;ff<=size(fac[1]);ff++){
 oneFactor=fac[1][ff];
 encoded=string(oneFactor);
 setring integral;
 execute("poly integralPolynomial="+encoded+";");
 decoded=string(integralPolynomial);
 kill integralPolynomial;
 setring rr;
 execute("poly roundTrip="+decoded+";");
 if(roundTrip!=oneFactor){ERROR("factor is not integral");}
 kill roundTrip;
}
oneFactor=fac[1][2];value=atPowerOrigin(oneFactor);
poly expected=(10296u23-59664u21-104328u19+447232u17-334192u15+44448u13-13296u11-4096u9+42296u7-24464u5+3960u3);
if(value!=expected){ERROR("origin coefficient certificate differs");}
print("PASS: integral polynomial round trips and origin certificate");
