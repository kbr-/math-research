// Prediction stated before the run: for an ENS path a-b-c-d (no cross generators), the modular law of
// lem:leaf-reduction for peeling a over x with U = the blocks within path distance k of a fails first at degree
// 3k + 5, independently of h (at h = 3: 8 for k = 1, 11 for k = 2).  This run: h = 4, k = 1 (U = {b}) and k = 2
// (U = {b, c}), degree bound 12 (degrees <= 11 compared).  Predicted output: 8 and 11.
// Blocks with h = 4 inputs, private coefficients: b on (x+1, y, yb3, yb4), c on (y+1, w, yc3, yc4),
// d on (w+1, yd2, yd3, yd4).  a is not needed: the law involves only R = {b, c, d}.
option(redSB);
ring P = 3, (x, y, w, yb3, yb4, yc3, yc4, yd2, yd3, yd4, rb(1..4), rc(1..4), rd(1..4)), dp;
proc tops(ideal L, ideal rr)
{
  poly Pp = 1; int i;
  for (i = 1; i <= 4; i++) { Pp = Pp - rr[i]*(1 - L[i]^2); }
  ideal I; for (i = 1; i <= 4; i++) { I = I, (1 - L[i]^2)*Pp; }
  for (i = 1; i <= nvars(basering); i++) { I = I, var(i)^3 - var(i); }
  ideal G = std(I); ideal Tp; int d; poly g;
  for (i = 1; i <= ncols(G); i++) { g = G[i]; d = deg(g); Tp = Tp, jet(g, d) - jet(g, d - 1); }
  return(Tp);
}
ideal Tb = tops(ideal(x + 1, y, yb3, yb4), ideal(rb(1..4)));
ideal Tc = tops(ideal(y + 1, w, yc3, yc4), ideal(rc(1..4)));
ideal Td = tops(ideal(w + 1, yd2, yd3, yd4), ideal(rd(1..4)));
ideal Cubes; int i; for (i = 1; i <= nvars(P); i++) { Cubes = Cubes, var(i)^3; }
qring Q = std(Cubes);
ideal Tb = fetch(P, Tb); ideal Tc = fetch(P, Tc); ideal Td = fetch(P, Td);
proc lawfail(poly v, ideal MU, ideal MW, int al, int DB)
{
  degBound = DB;
  ideal Xa = v^al;
  ideal L = intersect(Xa, MU + MW);
  ideal Rt = intersect(Xa, MU) + (v^al) * MW;
  ideal SRt = std(Rt);
  degBound = 0;
  int least = DB; poly witness = 0; int k;
  for (k = 1; k <= ncols(L); k++) {
    if (L[k] != 0 && deg(L[k]) < least) { if (reduce(L[k], SRt) != 0) { least = deg(L[k]); witness = L[k]; } }
  }
  print("  least_failure_degree=" + string(least));
  if (witness != 0) { print("  witness: " + string(witness)); }
  return(least);
}
int DB = 12;
print("h=4 k=1 (U = {b}), al=1:"); int t1 = lawfail(x, Tb, Tc + Td, 1, DB);
print("h=4 k=2 (U = {b,c}), al=1:"); int t2 = lawfail(x, Tb + Tc, Td, 1, DB);
quit;
