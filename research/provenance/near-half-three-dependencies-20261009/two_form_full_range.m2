-- Full range of row counts for small n: Hilbert functions of A/I, A = GF(8)[x_1..x_n]/(x_i^2),
-- I generated by m products of two random linear forms, for every n = 2..11 and every m from
-- floor(n/2) to binomial(n,2).  One example per (n,m), seed 1.
-- Statement computed (side notebook near-half-pc-degree, entry-2026-10-09-many-dependency-series):
-- each line gives an upper bound, valid over the algebraic closure of F_2, for the generic value
-- g(n,m,j) = min over m-tuples of planes of dim (A/I)_j.  The companion script
-- generic_exactness.py combines these with the inequality
-- g(n,m,j) >= g(n,m-1,j) - g(n-2,m-1,j-2) to decide where g equals the product series.
-- Output: one line "n m h_0 h_1 ... h_n" per case.  Exact arithmetic.
setRandomSeed 1;
F = GF 8;
scan(toList(2..11), n -> (
    S := F[x_1..x_n];
    R := S/ideal apply(gens S, v -> v^2);
    scan(toList((n//2)..binomial(n,2)), m -> (
        I := ideal apply(m, i -> random(1,R)*random(1,R));
        h := apply(n+1, j -> hilbertFunction(j, R/I));
        print concatenate(toString n, " ", toString m, " ", demark(" ", apply(h, toString)));
        ))));
