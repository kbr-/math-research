// Graded ideal containment test for hypothesis (F) (cycle bmd-20261009-bm, 9 October 2026).
// Cross coordinates in the h-form (x = 1): P_L / Vand^2 = det Ghat_L(e; y), with upper rows c_i h_(t+i-M+1) and lower rows
// sum_(r >= max(1,-i)) c_r c_(i+r) e^r h_(t+i+r-M+1), t < M, c_n = binom(-3/2, n). The coefficient of e^b is the
// coefficient of x^(sum L + b) e^b. For family p (k = M - p) and a set L with excess E+, E- and b = B(L) + delta, the
// x-degree above A_p is d = E+ + delta. Candidate (implies (F)): every such coefficient lies in the ideal I_d generated by
// the least-coefficient minors D_(L') of family p (negative part [-p,-1], nonnegative part L'+) with excess <= d.
// Tested exactly for M = 3 (p = 1, 2) and M = 4 (p = 1, 2, 3), E+ <= 2, E- <= 1, delta <= 2 (d <= 3 where available).
LIB "general.lib";
proc hh(int n)
{
  if (n < 0) { return(poly(0)); }
  if (n == 0) { return(poly(1)); }
  poly r = 0; int i; ideal m = maxideal(n);
  for (i = 1; i <= size(m); i++) { r = r + m[i]; }
  return(r);
}
proc cc(int n)
{
  if (n < 0) { return(number(0)); }
  number r = 1; int j;
  for (j = 0; j < n; j++) { r = r * (-3/2 - j) / (j + 1); }
  return(r);
}
// coordinate polynomial in e (var(nvars)) for column list L, truncated at e-degree R
proc coord(intvec L, int M, int R)
{
  int n = size(L); matrix G[n][n]; int t, u, r, i;
  for (u = 1; u <= n; u++)
  {
    i = L[u];
    for (t = 0; t < M; t++)
    {
      if (i >= 0) { G[t + 1, u] = cc(i) * hh(t + i - M + 1); }
      poly s = 0;
      for (r = 1; r <= R; r++) { if (i + r >= 0) { s = s + cc(r) * cc(i + r) * var(nvars(basering))^r * hh(t + i + r - M + 1); } }
      G[M + t + 1, u] = s; kill s;
    }
  }
  return(jet(det(G), R, intvec(0:(nvars(basering) - 1), 1)));
}
proc ecoef(poly f, int b)
{
  intvec w = intvec(0:(nvars(basering) - 1), 1);
  poly g = jet(f, b, w); if (b > 0) { g = g - jet(f, b - 1, w); }
  return(subst(g / var(nvars(basering))^b, var(nvars(basering)), 0));
}
// all nonnegative parts of size n with excess <= E (subsets of [0, n-1+E])
proc posparts(int n, int E)
{
  list res; int c, j, cnt, s;
  int top = n + E; // elements in [0, top-1]
  for (c = 0; c < 2^top; c++)
  {
    intvec v; cnt = 0; s = 0;
    for (j = 0; j < top; j++) { if ((c div 2^j) mod 2 == 1) { cnt++; v[cnt] = j; s = s + j; } }
    if (cnt == n) { int ex = s - n * (n - 1) div 2; if (ex <= E) { res = insert(res, list(v, ex), size(res)); } kill ex; }
    kill v;
  }
  return(res);
}
proc negparts(int p, int F)
{
  list res; int c, j, cnt, s; int top = p + F;
  for (c = 0; c < 2^top; c++)
  {
    intvec v; cnt = 0; s = 0;
    for (j = 1; j <= top; j++) { if ((c div 2^(j - 1)) mod 2 == 1) { cnt++; v[cnt] = -j; s = s + j; } }
    if (cnt == p) { int ex = s - p * (p + 1) div 2; if (ex <= F) { res = insert(res, list(v, ex), size(res)); } kill ex; }
    kill v;
  }
  return(res);
}
proc sortiv(intvec v)
{
  int i, j, tmp; intvec w = v;
  for (i = 1; i <= size(w); i++) { for (j = i + 1; j <= size(w); j++) { if (w[j] < w[i]) { tmp = w[i]; w[i] = w[j]; w[j] = tmp; } } }
  return(w);
}
proc runM(int M, int Emax, int dmax)
{
  int p, k, a, b, d, delta, B0, Bset, cntok, cntbad, cnttot, idx;
  for (p = 1; p <= M - 1; p++)
  {
    k = M - p; B0 = p * p - p + M;
    list pos = posparts(M + k, dmax + 1);  // for the generators
    list neg0 = negparts(p, 0); intvec N0 = neg0[1][1];
    // generators: least coefficients of [-p,-1] u L+ with excess <= d, for each d
    list gens; // gens[d+1] = ideal
    for (d = 0; d <= dmax; d++) { gens[d + 1] = ideal(0); }
    for (idx = 1; idx <= size(pos); idx++)
    {
      intvec Lp = pos[idx][1]; int ex = pos[idx][2];
      intvec L = sortiv(intvec(N0, Lp));
      poly D = ecoef(coord(L, M, B0), B0);
      for (d = ex; d <= dmax; d++) { gens[d + 1] = gens[d + 1], D; }
      kill Lp; kill ex; kill L; kill D;
    }
    list SI; for (d = 0; d <= dmax; d++) { SI[d + 1] = std(gens[d + 1]); }
    cntok = 0; cntbad = 0; cnttot = 0;
    list neg = negparts(p, 1); list posE = posparts(M + k, Emax);
    int ni, pi2;
    for (ni = 1; ni <= size(neg); ni++)
    {
      for (pi2 = 1; pi2 <= size(posE); pi2++)
      {
        intvec L = sortiv(intvec(neg[ni][1], posE[pi2][1])); int Ep = posE[pi2][2]; int Em = neg[ni][2];
        Bset = B0 + Em;
        poly P = coord(L, M, Bset + 2);
        for (delta = 0; delta <= 2; delta++)
        {
          d = Ep + delta;
          if (d <= dmax)
          {
            poly cf = ecoef(P, Bset + delta);
            cnttot++;
            if (reduce(cf, SI[d + 1]) == 0) { cntok++; } else { cntbad++; print("   FAIL: M = " + string(M) + ", p = " + string(p) + ", L = " + string(L) + ", delta = " + string(delta) + ", d = " + string(d)); }
            kill cf;
          }
        }
        kill L; kill Ep; kill Em; kill P;
      }
    }
    print("M = " + string(M) + ", p = " + string(p) + ": " + string(cnttot) + " coefficients tested, " + string(cntok) + " in I_d, " + string(cntbad) + " not");
    kill pos; kill neg0; kill N0; kill gens; kill SI; kill neg; kill posE; kill ni; kill pi2;
  }
}
ring r3 = 0, (y1, y2, y3, e), dp;
runM(3, 2, 3);
ring r4 = 0, (y1, y2, y3, y4, e), dp;
runM(4, 1, 2);
quit;
