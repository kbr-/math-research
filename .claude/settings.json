{
  "autoCompactWindow": 800000,
  "remoteControlAtStartup": true,
  "permissions": {
    "allow": [
      "Bash(./compute.sh:*)",
      "Bash(./tools/:*)",
      "Bash(python3 tools/:*)",
      "Bash(python3 resource-controls/setup.py)",
      "Bash(python3 -m unittest:*)",
      "Bash(systemctl --user status:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(git worktree list)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(wc:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "printf %s '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"Compaction happened. Immediately perform the Resume protocol before doing anything else\"}}'"
          }
        ]
      }
    ]
  }
}
