// Question: in which degrees does the top ideal n of one complete accuracy-one ENS block over F_3 (h inputs
// x, y_2..y_h, coefficients r_1..r_h; tops of the reduced dp basis, modulo all cubes) agree with the ideal
// generated by the companion tops rho'*L_i^2 (i = 1..h) and the cubes?  Output per h: the least degree in which
// n has an element outside the companion-top ideal (both computed with a degree bound).
option(redSB);
proc lowrun(int h, int DB)
{
  ring P = 3, (x, y(2..h), r(1..h)), dp;
  ideal L = x; int i; for (i = 2; i <= h; i++) { L = L, y(i); }
  poly Pp = 1; for (i = 1; i <= h; i++) { Pp = Pp - r(i)*(1 - L[i]^2); }
  ideal I; for (i = 1; i <= h; i++) { I = I, (1 - L[i]^2)*Pp; }
  for (i = 1; i <= nvars(P); i++) { I = I, var(i)^3 - var(i); }
  ideal G = std(I); ideal Tp; int d; poly g;
  for (i = 1; i <= ncols(G); i++) { g = G[i]; d = deg(g); Tp = Tp, jet(g, d) - jet(g, d - 1); }
  poly rho = 0; for (i = 1; i <= h; i++) { rho = rho + r(i)*L[i]^2; }
  ideal C; for (i = 1; i <= h; i++) { C = C, rho*L[i]^2; }
  ideal Cubes; for (i = 1; i <= nvars(P); i++) { Cubes = Cubes, var(i)^3; }
  degBound = DB;
  ideal SN = std(Tp + Cubes); ideal SC = std(C + Cubes);
  degBound = 0;
  int least = DB; int k;
  for (k = 1; k <= ncols(SN); k++) { if (SN[k] != 0 && deg(SN[k]) < least) { if (reduce(SN[k], SC) != 0) { least = deg(SN[k]); } } }
  print("h=" + string(h) + " DB=" + string(DB) + " least_degree_beyond_companion_tops=" + string(least));
}
lowrun(3, 11); lowrun(4, 11); lowrun(5, 11); lowrun(6, 12);
quit;
