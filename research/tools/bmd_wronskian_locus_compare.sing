// Locus comparison at M = 5, k = 2 (cycle bmd-20261009-be, 9 October 2026), conj:cube-ramification-flow-order.
// bmd_wronskian_triangular.sing found w_2 != c hh_2 mod J_1 = (Hank_2, D Hank_2) at M = 5, k = 2. The conjecture
// only needs equal vanishing loci on distinct-root clusters: V(J_1, w_2) = V(J_1, hh_2) off the discriminant.
// Computes both ideals saturated by the Vandermonde, their dimensions, and mutual radical containment.
LIB "general.lib"; LIB "elim.lib"; LIB "primdec.lib";
proc subsetsk(int M, int k)
{
  list L; int c, t, cnt;
  for (c = 0; c < 2^M; c++)
  {
    intvec s; cnt = 0;
    for (t = 1; t <= M; t++) { if ((c div 2^(t - 1)) mod 2 == 1) { cnt++; s[cnt] = t; } }
    if (cnt == k) { L = insert(L, s, size(L)); }
    kill s;
  }
  return(L);
}
proc zcoef(poly f, int n)
{
  poly g = jet(f, n, intvec(1, 0:(nvars(basering) - 1)));
  if (n > 0) { g = g - jet(f, n - 1, intvec(1, 0:(nvars(basering) - 1))); }
  return(subst(g / var(1)^n, var(1), 0));
}
ring r5 = 0, (z, y1, y2, y3, y4, y5), dp;
int M = 5; int k = 2; int p = M - k; int N = M + k; int nmax = 2; int i, j, a, b;
poly pi = 1; for (i = 1; i <= M; i++) { pi = pi * (1 - var(i + 1) * var(1)); }
poly V = 1; for (a = 1; a <= M; a++) { for (b = a + 1; b <= M; b++) { V = V * (var(b + 1) - var(a + 1)); } }
list B;
for (j = 1; j <= M; j++) { B = insert(B, diff(var(1)^j, var(1)) * pi - var(1)^j * diff(pi, var(1)), size(B)); }
for (j = p - 1; j <= M - 2; j++) { B = insert(B, var(1)^j * pi, size(B)); }
matrix Wm[N][N];
for (j = 1; j <= N; j++) { poly f = B[j]; for (i = 1; i <= N; i++) { Wm[i, j] = jet(f, nmax + N, intvec(1, 0:M)); f = diff(f, var(1)); } kill f; }
poly W = jet(det(Wm), nmax, intvec(1, 0:M));
list SS = subsetsk(M, k + 1); poly Hh = 0;
for (j = 1; j <= size(SS); j++)
{
  intvec S = SS[j]; poly vs = 1; poly rest = 1;
  for (a = 1; a <= size(S); a++) { for (b = a + 1; b <= size(S); b++) { vs = vs * (var(S[b] + 1) - var(S[a] + 1)); } }
  for (i = 1; i <= M; i++) { int inS = 0; for (a = 1; a <= size(S); a++) { if (S[a] == i) { inS = 1; } } if (inS == 0) { rest = rest * (1 - var(1) * var(i + 1))^(2 * k); } kill inS; }
  Hh = Hh + vs^2 * jet(rest, nmax, intvec(1, 0:M)); kill S; kill vs; kill rest;
}
poly h0 = zcoef(Hh, 0); poly h1 = zcoef(Hh, 1); poly h2 = zcoef(Hh, 2);
poly w0 = zcoef(W, 0); poly w1 = zcoef(W, 1); poly w2 = zcoef(W, 2);
// work in the y-ring only
ring ry = 0, (y1, y2, y3, y4, y5), dp;
map phi = r5, 0, y1, y2, y3, y4, y5;
poly h0 = phi(h0); poly h1 = phi(h1); poly h2 = phi(h2); poly w2 = phi(w2); poly V = phi(V);
ideal J1 = h0, h1;
ideal Iw = sat(J1 + ideal(w2), V)[1];
ideal Ih = sat(J1 + ideal(h2), V)[1];
ideal J1s = sat(J1, V)[1];
print("dim V(J1) off collisions: " + string(dim(std(J1s))) + "; dim V(J1, w2): " + string(dim(std(Iw))) + "; dim V(J1, hh2): " + string(dim(std(Ih))));
ideal rw = radical(Iw); ideal rh = radical(Ih);
int c1 = 1; int c2 = 1;
for (i = 1; i <= size(rh); i++) { if (reduce(rh[i], std(rw)) != 0) { c1 = 0; } }
for (i = 1; i <= size(rw); i++) { if (reduce(rw[i], std(rh)) != 0) { c2 = 0; } }
print("rad V(J1,w2) contained in rad V(J1,hh2) [rad(Ih) in rad(Iw)]: " + string(c1) + "; reverse: " + string(c2));
print("w2 in rad(J1 + hh2) off collisions: " + string(reduce(w2, std(rh)) == 0) + "; hh2 in rad(J1 + w2): " + string(reduce(h2, std(rw)) == 0));
quit;
