// Parallel pair with R added: blocks a (inputs x, ya(2..h)) and b (inputs x+1, yb(2..h)) over F_3, private
// coefficients, each Groebner-augmented separately, plus R = P_a P_b (q_a - q_b).  J = homogenization with z of
// all these and every field equation.  Printed: lowest degree < DB of an element of (J:z) not in J (DB if none).
// Rerun of h = 5 at degree bound 10 (a fall at degree 9 needs z g in degree 10). Prediction stated before the
// run, fitted from h = 3, 4: lowest fall exactly at h + 4 = 9.
option(redSB);
proc runcase(int h, int DB)
{
  int i;
  ring S = 3, (x, ya(2..h), yb(2..h), ra(1..h), rb(1..h), z), dp;
  ideal La = x; ideal Lb = x + 1;
  for (i = 2; i <= h; i++) { La = La, ya(i); Lb = Lb, yb(i); }
  poly Pa = 1; poly Pb = 1;
  for (i = 1; i <= h; i++) { Pa = Pa - ra(i)*(1 - La[i]^2); Pb = Pb - rb(i)*(1 - Lb[i]^2); }
  ideal Fa = x^3 - x; ideal Fb = x^3 - x;
  for (i = 2; i <= h; i++) { Fa = Fa, ya(i)^3 - ya(i); Fb = Fb, yb(i)^3 - yb(i); }
  for (i = 1; i <= h; i++) { Fa = Fa, ra(i)^3 - ra(i); Fb = Fb, rb(i)^3 - rb(i); }
  ideal Ia = Fa; ideal Ib = Fb;
  for (i = 1; i <= h; i++) { Ia = Ia, (1 - La[i]^2)*Pa; Ib = Ib, (1 - Lb[i]^2)*Pb; }
  ideal Ga = std(Ia); ideal Gb = std(Ib);
  poly R = Pa*Pb*((1 - La[1]^2) - (1 - Lb[1]^2));
  ideal J = homog(Ga, z) + homog(Gb, z), homog(R, z);
  degBound = DB; ideal SJ = std(J); ideal Q = quotient(SJ, z); degBound = 0;
  int lowest = DB;
  for (i = 1; i <= ncols(Q); i++) { if (Q[i] != 0 && deg(Q[i]) < lowest) { if (reduce(Q[i], SJ) != 0) { lowest = deg(Q[i]); } } }
  print("CASE h=" + string(h) + " DB=" + string(DB) + " predicted_no_fall_below=" + string(h + 3) + " lowest_fall=" + string(lowest));
}


runcase(5, 10);
quit;
