// Included by the retained generated connection presentation.
// modulo computes the preimage of the relation submodule under f -> f*v.
module relationModule=relations;
module vectorModule=distinguished;
print("START annihilator modulo");
module cubePreimage=modulo(vectorModule,relationModule);
ideal joint=std(ideal(cubePreimage));
print("BASIS_BEGIN"); print(joint); print("BASIS_END");
int ii,jj,kk,operatorOrder,totalWeight,termWeight,mm,minimum,paircount;
intvec exps,firstexp,secondexp;
poly term,firstmult,secondmult,sp;
proc require(int condition,string message)
{if(!condition){ERROR(message);}}
for(ii=1;ii<=size(joint);ii++)
{
 exps=leadexp(joint[ii]); operatorOrder=exps[1]; totalWeight=operatorOrder;
 for(kk=2;kk<=nvars(basering);kk++){totalWeight=totalWeight+parameterWeights[kk-1]*exps[kk];}
 term=joint[ii];
 while(term!=0)
 {
  exps=leadexp(term); termWeight=exps[1];
  for(kk=2;kk<=nvars(basering);kk++){termWeight=termWeight+parameterWeights[kk-1]*exps[kk];}
  require(termWeight==totalWeight,"inhomogeneous weighted operator");
  term=term-lead(term);
 }
 print("GENERATOR "+string(ii)+" order="+string(operatorOrder)+" excess="+string(totalWeight-operatorOrder));
}
for(ii=1;ii<=size(joint);ii++)
{for(jj=ii+1;jj<=size(joint);jj++)
 {
  firstexp=leadexp(joint[ii]); secondexp=leadexp(joint[jj]);
  firstmult=1; secondmult=1;
  for(kk=1;kk<=nvars(basering);kk++)
  {
   if(secondexp[kk]>firstexp[kk]){firstmult=firstmult*var(kk)^(secondexp[kk]-firstexp[kk]);}
   if(firstexp[kk]>secondexp[kk]){secondmult=secondmult*var(kk)^(firstexp[kk]-secondexp[kk]);}
  }
  sp=firstmult*joint[ii]/leadcoef(joint[ii])-secondmult*joint[jj]/leadcoef(joint[jj]);
  require(reduce(sp,joint)==0,"nonzero Buchberger pair"); paircount++;
 }}
for(mm=0;mm<=2^(cubeN-1)*2+3;mm++)
{
 minimum=1000000;
 for(ii=1;ii<=size(joint);ii++)
 {
  exps=leadexp(joint[ii]); operatorOrder=exps[1]; termWeight=0;
  for(kk=2;kk<=nvars(basering);kk++){termWeight=termWeight+parameterWeights[kk-1]*exps[kk];}
  if(operatorOrder<=mm && termWeight<minimum){minimum=termWeight;}
 }
 print("THRESHOLD m="+string(mm)+" excess="+string(minimum));
 if(cubeN==3)
 {
  if(mm<8){require(minimum==1000000,"control lower order");}
  if(mm==8){require(minimum==3,"control boundary degree");}
  if(mm>=9){require(minimum==0,"control final drop");}
 }
}
print("PASS complete weighted annihilator; homogeneity; "+string(paircount)+" Buchberger pairs; threshold control");
quit;
