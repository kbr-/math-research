{"event": "run_start", "monotonic_s": 332926.32688372, "unix_s": 1789392748.4074795, "id": "392fbec82e", "category": "local_processing", "command": ["python3", "-c", "import collections, json, pathlib, re, subprocess\nroot = pathlib.Path(\".\")\nturn = \"unit_accuracy_shared_bit_source_20260914_137\"\ndest = root / \"research/results\" / turn\nentry_id = \"entry-2026-09-14-unit-accuracy-shared-bit-source\"\nhtml = (root / \"notebook.html\").read_text()\nold = subprocess.check_output([\"git\", \"show\", \"HEAD:notebook.html\"], text=True)\nmarker = \"<!-- Append new dated mathematical entries here, preserving earlier entries. -->\"\nbegin = '<article class=\"research-entry\"'\nnew_entry = '<article class=\"research-entry\" id=\"' + entry_id + '\">'\nassert old[old.index(begin):old.index(marker)] == html[html.index(begin):html.index(new_entry)]\nentry = html[html.index(new_entry):html.index(marker)]\nids = collections.Counter(re.findall(r'\\bid=\"([^\"]+)\"', html))\nanchors = re.findall(r'href=\"#([^\"]+)\"', entry)\nassert all(ids[x] == 1 for x in anchors + [entry_id])\nassert html.count(\"<!-- TIMING \" + turn + \" -->\") == 1\noutputs = {}\nfor filename, expected in [(\"NS-unit-affine.jsonl\", 103), (\"NS-unit-shared-bit.jsonl\", 60)]:\n    counts = collections.Counter()\n    summaries = []\n    with (dest / filename).open() as source:\n        for line in source:\n            item = json.loads(line)\n            counts[item[\"record\"]] += 1\n            if \"passed\" in item:\n                assert item[\"passed\"] is True\n            if item[\"record\"] in (\"summary\", \"case_summary\"):\n                summaries.append(item)\n    final = [x for x in summaries if x[\"record\"] == \"summary\"]\n    assert len(final) == 1 and final[0][\"NS_certificates\"] == expected\n    outputs[filename] = {\"record_counts\": dict(counts), \"summaries\": summaries}\nassert outputs[\"NS-unit-affine.jsonl\"][\"record_counts\"][\"NS_certificate\"] == 100\nassert outputs[\"NS-unit-affine.jsonl\"][\"record_counts\"][\"Boolean_reduction_certificate\"] == 3\nassert outputs[\"NS-unit-affine.jsonl\"][\"record_counts\"][\"conditional_model\"] == 512\nassert outputs[\"NS-unit-shared-bit.jsonl\"][\"record_counts\"][\"model\"] == 35\nresult = {\n    \"session\": turn,\n    \"previous_research_record_unchanged\": True,\n    \"entry_internal_links_checked\": len(anchors),\n    \"unique_timing_placeholder\": True,\n    \"default_regressions\": \"Both byte comparisons passed; source comparison path corrected after first failure.\",\n    \"outputs\": outputs,\n    \"passed\": True\n}\nwith (dest / \"check-metadata.json\").open(\"x\") as target:\n    json.dump(result, target, indent=2)\n    target.write(\"\\n\")\nprint(json.dumps(result, indent=2))\n"], "output": "logs/unit_accuracy_shared_bit_source_20260914_137-392fbec82e.output.txt", "cwd": "/home/kbr/dev/math", "systemd_unit": "mathcompute-job-06cb81ac5bb2484e91dafd4253b2f820.service", "threads": 1, "timeout_s": 180}
