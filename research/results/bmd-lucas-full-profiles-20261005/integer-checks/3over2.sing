for(h=3;h<=7;h++){cf=subst(W/t^(h-3),t,0);for(j=1;j<=9;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=7;k++){W=W+bc(2,k)*(-ss*t+t^2)^k;}
