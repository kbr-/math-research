// Exact generic seven-label audit; same series and scope as the companion PARI pilot.
// Singular's coefficient field normalizes rational functions in four parameters.
// Stages: original coefficient series, checked basis/kernel transforms, complete
// even/mixed limit supports. No finite slope samples and no discarded lower powers.
ring S=(3,b,c,d,e),(y),dp;
proc beta(int j)
{
 int v=1;
 if(j%3==1){v=-1;}
 j=j div 3;
 while(j>0){if(j%3==2){return(0);}j=j div 3;}
 return(v);
}
proc check(int ok,string msg)
{
 if(!ok){ERROR(msg);}
}
list aa=0,1,b;
list bb=0,c,d,e;
int cut=12;
int precision=12;
int nc=26;
int completedBlocks=0;
int block,nr,prec,i,j,k,m,u,v,r,step,total,rk,col,row,pos;
number fac;
poly pol;
list seriesCoeffs,pairs,q,next;
matrix A,T,K,Q,P,C,Bmat;
module B;
intvec support,vals;
print("FIELD F3(b,c,d,e); slopes [0,1,b], [0,c,d,e]; common y shift12; precision12");
for(block=1;block<=2;block++)
{
 nr=11;if(block==2){nr=12;}
 prec=precision;seriesCoeffs=list();pairs=list();
 for(m=0;m<=prec;m++){matrix Z[nr][nc];seriesCoeffs[m+1]=Z;kill Z;}
 if(block==1)
 {
  matrix Z=seriesCoeffs[1];Z[1,cut+1]=1;Z[2,cut+1]=-1;Z[2,cut+2]=1;seriesCoeffs[1]=Z;kill Z;
  for(i=1;i<=3;i++){for(j=i+1;j<=3;j++){pairs[size(pairs)+1]=list(aa[i],aa[j],0,0);}}
  for(i=1;i<=4;i++){for(j=i+1;j<=4;j++){pairs[size(pairs)+1]=list(bb[i],bb[j],1,1);}}
 }
 else
 {for(i=1;i<=3;i++){for(j=1;j<=4;j++){pairs[size(pairs)+1]=list(aa[i],bb[j],0,1);}}}
 for(k=1;k<=size(pairs);k++)
 {
  q=pairs[k];r=k;if(block==1){r=r+2;}
  for(m=0;m<=prec;m++)
  {
   pol=0;
   for(u=0;u<=m;u++)
   {
    v=m-u;fac=beta(u)*beta(v)*q[1]^u*q[2]^v;
    pos=cut-q[3]*u-q[4]*v;if(block==1){pos=pos+q[3];}
    check(pos>=0,"negative retained polynomial exponent");pol=pol+fac*y^pos;
   }
   pol=pol*(y-1)^m;
   matrix Z=seriesCoeffs[m+1];
   while(pol!=0)
   {pos=leadexp(pol)[1];check(pos<nc,"coefficient window overflow");Z[r,pos+1]=leadcoef(pol);pol=pol-lead(pol);}
   seriesCoeffs[m+1]=Z;kill Z;
  }
 }
 step=0;total=0;
 print("BLOCK "+string(block)+" ROWS "+string(nr));
 while(1)
 {
  A=transpose(seriesCoeffs[1]);B=std(module(A));rk=size(B);
  print("STEP "+string(step)+" PRECISION "+string(prec)+" RANK "+string(rk));
  if(rk==nr){break;}
  check(prec>0,"precision exhausted; no conclusion");
  T=lift(module(A),B);K=syz(module(A));
  check(ncols(K)==nr-rk,"kernel dimension mismatch");
  matrix Z[nr][nr];
  for(i=1;i<=nr;i++)
  {for(j=1;j<=rk;j++){Z[i,j]=T[i,j];}for(j=rk+1;j<=nr;j++){Z[i,j]=K[i,j-rk];}}
  Q=Z;kill Z;
  check(det(Q)!=0,"singular basis change");
  C=A*Q;Bmat=matrix(B);
  for(i=1;i<=nc;i++)
  {for(j=1;j<=rk;j++){check(C[i,j]==Bmat[i,j],"basis reconstruction");}for(j=rk+1;j<=nr;j++){check(C[i,j]==0,"kernel reconstruction");}}
  P=transpose(Q);
  print("TRANSFORM");print(P);
  next=list();
  for(m=0;m<=prec;m++){next[m+1]=P*seriesCoeffs[m+1];}
  seriesCoeffs=list();
  for(m=0;m<prec;m++)
  {
   matrix Z[nr][nc];matrix X=next[m+1];matrix Y=next[m+2];
   for(i=1;i<=nr;i++){for(j=1;j<=nc;j++){if(i<=rk){Z[i,j]=X[i,j];}else{Z[i,j]=Y[i,j];}}}
   seriesCoeffs[m+1]=Z;kill Z,X,Y;
  }
  total=total+nr-rk;prec--;step++;
 }
 support=intvec();pos=0;A=seriesCoeffs[1];
 for(j=1;j<=nc;j++)
 {
  k=0;for(i=1;i<=nr;i++){if(A[i,j]!=0){k=1;}}
  if(k){pos++;support[pos]=j-1-cut;}
 }
 print("VALUATION "+string(total));print("SUPPORT "+string(support));
 check(size(support)==nr,"limit not the predicted monomial space");
 for(i=1;i<=nr;i++)
 {
  if(block==1){check(support[i]==i-7,"even support differs");}
  else{if(i==1){check(support[i]==-7,"mixed lowest support differs");}else{check(support[i]==i-7,"mixed support differs");}}
 }
 print("LIMIT_BASIS");
 for(i=1;i<=nr;i++){pol=0;for(j=1;j<=nc;j++){pol=pol+A[i,j]*y^(j-1);}print(pol);}
 vals[block]=total;completedBlocks++;
}
check(completedBlocks==2,"both blocks must complete");
print("BLOCK_VALUATIONS "+string(vals));
print("GENERIC_SEVEN_LIMIT_COMPLETED");
quit;
