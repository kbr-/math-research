ring R = 3, (x(1..36), z), dp;
option(redSB);
ideal P = x(1)^2-x(1), x(2)^2-x(2), x(3)^2-x(3), x(4)^2-x(4), x(5)^2-x(5), x(6)^2-x(6), x(7)^2-x(7), x(8)^2-x(8), x(9)^2-x(9), x(10)^2-x(10), x(11)^2-x(11), x(12)^2-x(12), x(13)^2-x(13), x(14)^2-x(14), x(15)^2-x(15), x(16)^2-x(16), x(17)^2-x(17), x(18)^2-x(18), x(19)^2-x(19), x(20)^2-x(20), x(21)^2-x(21), x(22)^2-x(22), x(23)^2-x(23), x(24)^2-x(24), x(25)^2-x(25), x(26)^2-x(26), x(27)^2-x(27), x(28)^2-x(28), x(29)^2-x(29), x(30)^2-x(30), x(31)^2-x(31), x(32)^2-x(32), x(33)^2-x(33), x(34)^2-x(34), x(35)^2-x(35), x(36)^2-x(36), x(1)*x(13), x(1)*x(25), x(13)*x(25), x(2)*x(14), x(2)*x(26), x(14)*x(26), x(3)*x(15), x(3)*x(27), x(15)*x(27), x(4)*x(16), x(4)*x(28), x(16)*x(28), x(5)*x(17), x(5)*x(29), x(17)*x(29), x(6)*x(18), x(6)*x(30), x(18)*x(30), x(7)*x(19), x(7)*x(31), x(19)*x(31), x(8)*x(20), x(8)*x(32), x(20)*x(32), x(9)*x(21), x(9)*x(33), x(21)*x(33), x(10)*x(22), x(10)*x(34), x(22)*x(34), x(11)*x(23), x(11)*x(35), x(23)*x(35), x(12)*x(24), x(12)*x(36), x(24)*x(36), (1-((1*(x(1)+x(13)+x(25))+1*(x(2)+x(14)+x(26))+2*(x(3)+x(15)+x(27))+1*(x(4)+x(16)+x(28))+2*(x(5)+x(17)+x(29))+2*(x(6)+x(18)+x(30))+2*(x(7)+x(19)+x(31))+2*(x(8)+x(20)+x(32))+1*(x(9)+x(21)+x(33))+1*(x(10)+x(22)+x(34))+2*(x(11)+x(23)+x(35))+1*(x(12)+x(24)+x(36)))-1)^2);
