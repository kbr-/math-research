# Keep executable text portable and source documents byte-for-byte intact.
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.pdf binary
*.zip binary
*.png binary
*.npy binary
*.npz binary

# Historical documents and provenance must retain their original hashes.
php_codex_handoff/** -text
research/references/** -text
research/provenance/** -text
research/results/** -text
