F3[6,9]=bc(12,6)*(-u)^(6)+(-1)*C*bc(12,2)*(-u)^(-2);
F3[6,10]=bc(12,7)*(-u)^(7)+(-1)*C*bc(12,1)*(-u)^(-1);
F3[6,11]=bc(12,8)*(-u)^(8)+(-1)*C*bc(12,0)*(-u)^(-0);
F3[6,12]=bc(12,9)*(-u)^(9);
F3[6,13]=bc(12,10)*(-u)^(10);
F3[7,1]=bc(12,0)*(-u)^(0)+(-1)*C*bc(12,12)*(-u)^(-12);
F3[7,2]=bc(12,1)*(-u)^(1)+(-1)*C*bc(12,11)*(-u)^(-11);
F3[7,3]=bc(12,2)*(-u)^(2)+(-1)*C*bc(12,10)*(-u)^(-10);
F3[7,4]=bc(12,3)*(-u)^(3)+(-1)*C*bc(12,9)*(-u)^(-9);
F3[7,5]=bc(12,4)*(-u)^(4)+(-1)*C*bc(12,8)*(-u)^(-8);
F3[7,6]=bc(12,5)*(-u)^(5)+(-1)*C*bc(12,7)*(-u)^(-7);
F3[7,7]=bc(12,6)*(-u)^(6)+(-1)*C*bc(12,6)*(-u)^(-6);
F3[7,8]=bc(12,7)*(-u)^(7)+(-1)*C*bc(12,5)*(-u)^(-5);
F3[7,9]=bc(12,8)*(-u)^(8)+(-1)*C*bc(12,4)*(-u)^(-4);
F3[7,10]=bc(12,9)*(-u)^(9)+(-1)*C*bc(12,3)*(-u)^(-3);
F3[7,11]=bc(12,10)*(-u)^(10)+(-1)*C*bc(12,2)*(-u)^(-2);
F3[7,12]=bc(12,11)*(-u)^(11)+(-1)*C*bc(12,1)*(-u)^(-1);
F3[7,13]=bc(12,12)*(-u)^(12)+(-1)*C*bc(12,0)*(-u)^(-0);
W=0;for(k=0;k<=7;k++){W=W+bc(4,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=13;j++){R[1,j]=F3[1,j];}
for(h=1;h<=7;h++){cf=subst(W/t^(h-1),t,0);for(j=1;j<=13;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=7;k++){W=W+bc(3,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=13;j++){R[1,j]=F3[2,j];}
for(h=2;h<=7;h++){cf=subst(W/t^(h-2),t,0);for(j=1;j<=13;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=7;k++){W=W+bc(2,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=13;j++){R[1,j]=F3[3,j];}
for(h=3;h<=7;h++){cf=subst(W/t^(h-3),t,0);for(j=1;j<=13;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=7;k++){W=W+bc(1,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=13;j++){R[1,j]=F3[4,j];}
for(h=4;h<=7;h++){cf=subst(W/t^(h-4),t,0);for(j=1;j<=13;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=7;k++){W=W+bc(0,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=13;j++){R[1,j]=F3[5,j];}
for(h=5;h<=7;h++){cf=subst(W/t^(h-5),t,0);for(j=1;j<=13;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
for(j=1;j<=13;j++){D[12,j]=F3[6,j];}
for(j=1;j<=13;j++){D[13,j]=F3[7,j];}
print("dimension=13; maximum high depth=12");
poly detD=det(D);
if(detD==0){print("ZERO formal determinant");}else{list fac=factorize(detD);print(fac);poly product=1;int ff;for(ff=1;ff<=size(fac[1]);ff++){product=product*fac[1][ff]^fac[2][ff];}if(product!=detD){ERROR("factor product mismatch");}}
print("PASS: determinant factorization");quit;
