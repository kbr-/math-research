// Follow-up after review: the family closed under multiplication by x, x^2 and colon by x, x^2, which an adapted
// basis also keeps diagonal (distributivity of the lattice with only the x^kA is not sufficient over a chain ring).
// Tested here: the distributive law on all triples of the x-closed generating set G0' (duplicates removed).
// Original header follows.
// Necessary condition for a common adapted S-basis (S = F_3[x]/(x^3)) of one block's truncated algebra A for the
// ideals needed by the repaired-star argument: the distributive law a cap (b + c) = (a cap b) + (a cap c) on all
// triples from G1, where G0 = {n (block tops), rho'A, x rho''A, xA, x^2A} and G1 = G0 plus all pairwise sums and
// intersections of G0.  Block: complete accuracy-one ENS, inputs x (shared), y(2..h) private, coefficients r(1..h);
// tops of the reduced dp basis; A = F_3[vars]/(all cubes).  Output per h: size of G1, number of triples tested,
// number failing, and the first failing triple (indices into G1 with names).
option(redSB);
proc eqideal(ideal I1, ideal I2)
{
  ideal S1 = std(I1); ideal S2 = std(I2); int k;
  for (k = 1; k <= ncols(I1); k++) { if (reduce(I1[k], S2) != 0) { return(0); } }
  for (k = 1; k <= ncols(I2); k++) { if (reduce(I2[k], S1) != 0) { return(0); } }
  return(1);
}
proc drun(int h)
{
  ring P = 3, (x, y(2..h), r(1..h)), dp;
  ideal L = x; int i; for (i = 2; i <= h; i++) { L = L, y(i); }
  poly Pp = 1; for (i = 1; i <= h; i++) { Pp = Pp - r(i)*(1 - L[i]^2); }
  ideal I; for (i = 1; i <= h; i++) { I = I, (1 - L[i]^2)*Pp; }
  for (i = 1; i <= nvars(P); i++) { I = I, var(i)^3 - var(i); }
  ideal G = std(I); ideal Tp; int d; poly g;
  for (i = 1; i <= ncols(G); i++) { g = G[i]; d = deg(g); Tp = Tp, jet(g, d) - jet(g, d - 1); }
  poly rho = r(1)*x^2; for (i = 2; i <= h; i++) { rho = rho + r(i)*y(i)^2; }
  poly rho2 = 0; for (i = 2; i <= h; i++) { rho2 = rho2 + r(i)*y(i)^2; }
  ideal Cubes; for (i = 1; i <= nvars(P); i++) { Cubes = Cubes, var(i)^3; }
  qring Q = std(Cubes);
  ideal Tp = fetch(P, Tp); poly rho = fetch(P, rho); poly rho2 = fetch(P, rho2);
  list B0 = std(Tp), std(ideal(rho)), std(ideal(x*rho2)), std(ideal(x)), std(ideal(x^2));
  list bn = "n", "rho'A", "x rho''A", "xA", "x^2A";
  list G1; list nm; int a; int b; int e; ideal cand; int dup;
  for (a = 1; a <= size(B0); a++) {
    for (e = 0; e <= 4; e++) {
      if (e == 0) { cand = B0[a]; }
      if (e == 1) { cand = std(x*B0[a]); }
      if (e == 2) { cand = std(x^2*B0[a]); }
      if (e == 3) { cand = std(quotient(B0[a], ideal(x))); }
      if (e == 4) { cand = std(quotient(B0[a], ideal(x^2))); }
      dup = 0;
      for (b = 1; b <= size(G1); b++) { if (eqideal(cand, G1[b]) == 1) { dup = 1; break; } }
      if (dup == 0) {
        G1 = G1 + list(cand);
        if (e == 0) { nm = nm + list(bn[a]); }
        if (e == 1) { nm = nm + list("x*" + bn[a]); }
        if (e == 2) { nm = nm + list("x^2*" + bn[a]); }
        if (e == 3) { nm = nm + list("(" + bn[a] + ":x)"); }
        if (e == 4) { nm = nm + list("(" + bn[a] + ":x^2)"); }
      }
    }
  }
  int m = size(G1); int tested = 0; int failed = 0; int c; string first = "";
  for (a = 1; a <= m; a++) { for (b = 1; b <= m; b++) { for (c = b + 1; c <= m; c++) {
    tested++;
    ideal lhs = intersect(G1[a], G1[b] + G1[c]);
    ideal rhs = intersect(G1[a], G1[b]) + intersect(G1[a], G1[c]);
    if (eqideal(lhs, rhs) == 0) { failed++; if (first == "") { first = nm[a] + " cap (" + nm[b] + " + " + nm[c] + ")"; } }
    kill lhs, rhs;
  } } }
  print("h=" + string(h) + " xclosed_G0_size=" + string(m) + " triples_tested=" + string(tested) + " failed=" + string(failed));
  if (first != "") { print("  first failing: " + first); }
}
drun(3); drun(4);
quit;
