// Fourth merge: residual polynomial spaces F_c+x^7 F_(c-m), m=3,2.
// Their x-coefficient cuts are odd degrees 1,3,5, plus degree 2c+2 for m=2.
// Last-column determinants below are exact over Q; denominators require
// separate integer-binomial treatment in characteristics three and five.
ring rr=0,(c,d),dp;
proc bc(poly a,int r)
{
 poly v=1;int k;
 for(k=0;k<r;k++){v=v*(a-k)/(k+1);}
 return(v);
}
matrix A[3][3];matrix B[4][4];int i,j;
for(i=1;i<=3;i++)
{
 for(j=1;j<=3;j++){A[i,j]=bc(2*c-2+j,2*i-1);}
 for(j=1;j<=4;j++){B[i,j]=bc(2*c-1+j,2*i-1);}
}
B[4,3]=1;B[4,4]=2*c+3;
poly da=det(A);poly db=det(B);
print("A last-three determinant:");print(factorize(da));
print("B last-four determinant:");print(factorize(db));
print("at c=8d-17:");print(factorize(subst(da,c,8*d-17)));print(factorize(subst(db,c,8*d-17)));
quit;
