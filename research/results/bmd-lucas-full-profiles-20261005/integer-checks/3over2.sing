for(ff=2;ff<=size(fac[1]);ff++){
 oneFactor=fac[1][ff];
 encoded=string(oneFactor);
 setring integral;
 execute("poly integralPolynomial="+encoded+";");
 decoded=string(integralPolynomial);
 kill integralPolynomial;
 setring rr;
 execute("poly roundTrip="+decoded+";");
