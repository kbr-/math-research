// One exact local state for d6mod9: N7mod9,N0mod4,M0mod12.
// Retain c=u^N, x=(u-i)^N+(u+i)^N, y=i*((u-i)^N-(u+i)^N).
ring R=3,(u,c,x,y),dp;
proc bc(int k){intvec b=1,1,0,2,2,0,1,1;if(k<0 || k>7){return(0);}return(b[k+1]);}
proc hi(int rr,int jj){int k=rr-8+jj;if(k<0){return(0);}return(bc(k)*(-u)^k);}
proc ln(int rr,int jj){int k=rr-jj;if(k<0){return(0);}return(bc(k)*(-1)^k*u^jj);}
proc vv(int j){int k=((j%4)+4)%4;if(k==0){return(x);}if(k==1){return(y);}if(k==2){return(-x);}return(-y);}
matrix A[9][9];int j;
for(j=0;j<=8;j++){
 A[1,j+1]=(j+1)-j*u;
 A[2,j+1]=(-1)^j*((j+1)+j*u);
 A[3,j+1]=vv(j);
 A[4,j+1]=(j*(u^2+1)+1)*vv(j-1)-u*vv(j);
 A[5,j+1]=hi(0,j);if(j==0){A[5,j+1]=A[5,j+1]+c;}
 A[6,j+1]=u^6*hi(6,j)+c*ln(6,j);
 A[7,j+1]=hi(1,j)+2*hi(3,j)+hi(5,j);
 A[8,j+1]=u^4*ln(1,j)+2*u^2*ln(3,j)+ln(5,j);
 A[9,j+1]=u^4*(hi(2,j)+hi(4,j))-c*(u^2*ln(2,j)+ln(4,j));
}
matrix q[9][1];q[2,1]=u^2;q[3,1]=u;q[4,1]=2*u^2+1;q[5,1]=2*u;q[6,1]=u^2+2;q[7,1]=u;q[8,1]=1;
matrix kernel_residual=A*q;for(j=1;j<=9;j++){if(kernel_residual[j,1]!=0){ERROR("actual kernel polynomial identity failed");}}
print("PASS full symbolic boundary kernel identity");
print("BOUNDARY_MATRIX=");print(A);
matrix B=A;for(j=1;j<=9;j++){B[j,8]=0;}B[7,8]=c;B[8,8]=u^5;
poly omega=det(B);
if(omega==0){ERROR("first repair determinant is identically zero");}
print("REPAIR_DETERMINANT=");print(omega);
print("FACTORIZATION=");print(factorize(omega));
poly zero_c=subst(omega,c,0);
poly expected_zero=u^15*(u^2-1)^2*((1-u^2)*x^2+u*(u^2+1)*x*y-y^2);
if(zero_c!=expected_zero){ERROR("closed constant-c identity failed");}
poly remainder=(omega-zero_c)/c;
if(omega-zero_c-c*remainder!=0){ERROR("exact c split failed");}
poly lowest=zero_c;int degree_u=0;
if(lowest==0){ERROR("constant-c coefficient vanished");}
while(subst(lowest,u,0)==0){lowest=lowest/u;degree_u++;}
map origin_value=R,0,0,2,0;
poly coefficient=origin_value(lowest);
print("CONSTANT_C_COEFFICIENT=");print(zero_c);
print("NORMALIZED_CONSTANT_C=");print(lowest);
print("ACTUAL_LEADING_ORDER="+string(degree_u)+" COEFFICIENT="+string(coefficient));
if(coefficient==0 || degree_u>=448){ERROR("actual power control failed");}
print("PASS uniform nonzero repair: X(0)=2,Y(0)=0 and positive c terms start at N>=448");
quit;
