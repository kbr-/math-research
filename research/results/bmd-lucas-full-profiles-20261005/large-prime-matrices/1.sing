// c mod p = 1, alternative, p>19; N mod p=16.
ring rr=(0,u),(t,C,X,Y,U,V),dp;
proc bc(int n,int k){number ans=1;int ii;for(ii=1;ii<=k;ii++){ans=ans*(n-ii+1)/ii;}return(ans);}
matrix D[5][5];matrix R[1][5];
number ss=u^2+1/u^2;
int j,k,h;poly W,cf;
D[1,1]=U;
D[2,1]=((-10)*(1-u^2)+(16))*U+(16)*u*V;
D[3,1]=-X;
D[1,2]=V;
D[2,2]=((-9)*(1-u^2)+(16))*V+(16)*u*U;
D[3,2]=-Y;
D[1,3]=U;
D[2,3]=((-8)*(1-u^2)+(16))*U+(16)*u*V;
D[3,3]=X;
D[1,4]=V;
D[2,4]=((-7)*(1-u^2)+(16))*V+(16)*u*U;
D[3,4]=Y;
D[1,5]=U;
D[2,5]=((-6)*(1-u^2)+(16))*U+(16)*u*V;
D[3,5]=-X;
matrix F1[3][5];
F1[1,1]=(1)*C*bc(16,1)*(-u)^(-1);
F1[1,2]=(1)*C*bc(16,0)*(-u)^(-0);
F1[1,4]=bc(16,0)*(-u)^(0);
F1[1,5]=bc(16,1)*(-u)^(1);
F1[2,1]=(1)*C*bc(16,3)*(-u)^(-3);
F1[2,2]=bc(16,0)*(-u)^(0)+(1)*C*bc(16,2)*(-u)^(-2);
F1[2,3]=bc(16,1)*(-u)^(1)+(1)*C*bc(16,1)*(-u)^(-1);
F1[2,4]=bc(16,2)*(-u)^(2)+(1)*C*bc(16,0)*(-u)^(-0);
F1[2,5]=bc(16,3)*(-u)^(3);
F1[3,1]=bc(16,1)*(-u)^(1)+(1)*C*bc(16,5)*(-u)^(-5);
F1[3,2]=bc(16,2)*(-u)^(2)+(1)*C*bc(16,4)*(-u)^(-4);
F1[3,3]=bc(16,3)*(-u)^(3)+(1)*C*bc(16,3)*(-u)^(-3);
F1[3,4]=bc(16,4)*(-u)^(4)+(1)*C*bc(16,2)*(-u)^(-2);
F1[3,5]=bc(16,5)*(-u)^(5)+(1)*C*bc(16,1)*(-u)^(-1);
W=0;for(k=0;k<=3;k++){W=W+bc(1,k)*(-ss*t+t^2)^k;}
W=(1+t)^3*(1-t)^4*W;
for(j=1;j<=5;j++){R[1,j]=F1[1,j];}
for(h=1;h<=3;h++){cf=subst(W/t^(h-1),t,0);for(j=1;j<=5;j++){F1[h,j]=F1[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=3;k++){W=W+bc(0,k)*(-ss*t+t^2)^k;}
W=(1+t)^3*(1-t)^4*W;
for(j=1;j<=5;j++){R[1,j]=F1[2,j];}
for(h=2;h<=3;h++){cf=subst(W/t^(h-2),t,0);for(j=1;j<=5;j++){F1[h,j]=F1[h,j]-cf*R[1,j];}}
for(j=1;j<=5;j++){D[4,j]=F1[3,j];}
matrix F2[3][5];
F2[1,1]=(-1)*C*bc(16,1)*(-u)^(-1);
F2[1,2]=(-1)*C*bc(16,0)*(-u)^(-0);
F2[1,4]=bc(16,0)*(-u)^(0);
F2[1,5]=bc(16,1)*(-u)^(1);
F2[2,1]=(-1)*C*bc(16,3)*(-u)^(-3);
F2[2,2]=bc(16,0)*(-u)^(0)+(-1)*C*bc(16,2)*(-u)^(-2);
F2[2,3]=bc(16,1)*(-u)^(1)+(-1)*C*bc(16,1)*(-u)^(-1);
F2[2,4]=bc(16,2)*(-u)^(2)+(-1)*C*bc(16,0)*(-u)^(-0);
F2[2,5]=bc(16,3)*(-u)^(3);
F2[3,1]=bc(16,1)*(-u)^(1)+(-1)*C*bc(16,5)*(-u)^(-5);
F2[3,2]=bc(16,2)*(-u)^(2)+(-1)*C*bc(16,4)*(-u)^(-4);
F2[3,3]=bc(16,3)*(-u)^(3)+(-1)*C*bc(16,3)*(-u)^(-3);
F2[3,4]=bc(16,4)*(-u)^(4)+(-1)*C*bc(16,2)*(-u)^(-2);
F2[3,5]=bc(16,5)*(-u)^(5)+(-1)*C*bc(16,1)*(-u)^(-1);
W=0;for(k=0;k<=3;k++){W=W+bc(1,k)*(-ss*t+t^2)^k;}
W=(1+t)^2*(1-t)^5*W;
for(j=1;j<=5;j++){R[1,j]=F2[1,j];}
for(h=1;h<=3;h++){cf=subst(W/t^(h-1),t,0);for(j=1;j<=5;j++){F2[h,j]=F2[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=3;k++){W=W+bc(0,k)*(-ss*t+t^2)^k;}
W=(1+t)^2*(1-t)^5*W;
for(j=1;j<=5;j++){R[1,j]=F2[2,j];}
for(h=2;h<=3;h++){cf=subst(W/t^(h-2),t,0);for(j=1;j<=5;j++){F2[h,j]=F2[h,j]-cf*R[1,j];}}
for(j=1;j<=5;j++){D[5,j]=F2[3,j];}
print("dimension=5; maximum high depth=5");
poly detD=det(D);
if(detD==0){print("ZERO formal determinant");}else{list fac=factorize(detD);print(fac);poly product=1;int ff;for(ff=1;ff<=size(fac[1]);ff++){product=product*fac[1][ff]^fac[2][ff];}if(product!=detD){ERROR("factor product mismatch");}}
print("PASS: determinant factorization");quit;
