# Rebuilt resource controls, Python environments, and interpreter caches.
/.resource-runtime/
__pycache__/
*.py[cod]
.venv/
node_modules/

# Machine-local Codex state; research context is persisted in notes instead.
/.codex-session-id
/.codex-session-id.*
/.codex/
/.agents/

# Operational logs and scratch artifacts. Promote research evidence to
# research/results/ or research/provenance/ before committing a result.
/research/logs/
/research/tmp/
/research/.runs/
/tmp/

# The complete historical directory is tracked; its outer ZIP is redundant.
/php_codex_handoff.zip

# Local credentials and editor/OS temporary files.
.env
.env.*
!.env.example
*.swp
*.swo
*~
.DS_Store

# Local-only sources and backups not cleared for public redistribution.
/private/
/research/references/cache/BIKPRS.pdf
/research/references/cache/Razborov.pdf
/research/references/cache/Pebbling.pdf
/research/references/extracted/BIKPRS.txt
/research/references/extracted/Razborov.txt
/research/references/extracted/Pebbling.txt
/research/references/user_supplied/BIKPRS.pdf
/research/references/user_supplied/Razborov.pdf
