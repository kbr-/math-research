{"event": "run_start", "monotonic_s": 85192.455205564, "unix_s": 1789145014.5358014, "id": "84aa9dd0e1", "category": "local_processing", "command": ["python3", "-c", "\nimport argparse, json\nfrom pathlib import Path\np = argparse.ArgumentParser()\np.add_argument(\"--out\", required=True, type=Path)\np.add_argument(\"input\", type=Path)\na = p.parse_args()\ncases = []\nwith a.input.open() as stream:\n    for line in stream:\n        r = json.loads(line)\n        if r.get(\"record\") == \"case\":\n            pairs = [q for s in r[\"steps\"] for q in s.get(\"input_pairs\", [])]\n            cases.append({k: r[k] for k in (\"p\", \"matched_nodes\", \"final_arguments\", \"argument_width\", \"nonliteral_input_pairs\", \"ordinary_comparisons\", \"removed_frontier_roots\", \"all_passed\")} | {\"physical_nodes\": len(r[\"nodes\"]), \"auxiliary_witnesses\": sum(q.get(\"auxiliary_family\", -1) >= 0 for q in pairs)})\nreport = {\"schema\": 1, \"input\": str(a.input), \"cases\": cases, \"totals\": {k: sum(c[k] for c in cases) for k in (\"nonliteral_input_pairs\", \"ordinary_comparisons\", \"removed_frontier_roots\", \"auxiliary_witnesses\")}}\nwith a.out.open(\"x\") as stream:\n    json.dump(report, stream, indent=2)\n    stream.write(\"\\n\")\nprint(json.dumps(report[\"totals\"]))\n", "--out", "research/results/mod_frontier_occurrences_20260911_27/summary.json", "research/results/mod_frontier_occurrences_20260911_27/checks-02.jsonl"], "output": "logs/mod_frontier_occurrences_20260911_27-84aa9dd0e1.output.txt", "cwd": "/home/kbr/dev/math", "systemd_unit": "mathcompute-job-cb72516387814dee828221bdaf1401c0.service", "threads": 1, "timeout_s": 180}
