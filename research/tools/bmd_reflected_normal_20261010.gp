\\ Exact original boundary normal-map controls, n5, rational and ternary.
\\ Stages: full square-root prefix; analytic parameter derivatives; two-sided
\\ kernel pairing; export all matrices for independent GAP rank checks.
default(parisizemax,500000000);
default(parisize,64000000);
default(nbthreads,1);
T='T;z='z;
assert(c,s)={if(!c,error(s));};
out=getenv("BMD_NORMAL_GAP");
write(out,"# Independent rank input generated by the retained PARI script.");
write(out,"g:=First(Elements(GF(27)), a -> a^3-a+One(a)=Zero(a));;");
write(out,"Decode:=function(x) if x=-1 then return Zero(g); else return g^x; fi; end;;");
write(out,"Cases:=[];;");
{
for(mode=1,2,
 my(o,aa,gen);
 if(mode==1,o=1;aa=[0,1,2,-1,4,-3],
  gen=ffgen(Mod(1,3)*(z^3-z+1),'g);o=gen^0;
  assert(fforder(gen)==26,"export field generator order");
  aa=[0*o,o,gen,o-gen,gen^2,o-gen^2]
 );
 my(N=#aa,n=N-1,D=N*(N-1)/2+2,L=D+1,rows=List(),der=List());
 assert(#Set(aa)==N,"distinct labels");
 listput(rows,vector(L,c,if(c==1,o,0*o)));
 listput(rows,vector(L,c,if(c==2,o,0*o)));
 for(i=1,N,for(j=i+1,N,
  my(F=sqrt((o+aa[i]*T)*(o+aa[j]*T)+O(T^L)));
  listput(rows,vector(L,c,polcoef(F,c-1,T)))
 ));
 my(M=matrix(D,L,i,j,rows[i][j]));
 for(v=2,N,
  my(Rows=List([vector(L,c,0*o),vector(L,c,0*o)]));
  for(i=1,N,for(j=i+1,N,
   my(F=if(v==i||v==j,T*sqrt((o+aa[i]*T)*(o+aa[j]*T)+O(T^L))/(2*(o+aa[v]*T)),0*o+O(T^L)));
   listput(Rows,vector(L,c,polcoef(F,c-1,T)))
  ));
  listput(der,matrix(D,L,i,j,Rows[i][j]))
 );
 my(Left=matker(M~),Right=matker(M),lc=matsize(Left)[2],rc=matsize(Right)[2],
 Q=matrix(n,lc*rc,v,c, (Left[,1+(c-1)\rc]~*der[v]*Right[,1+(c-1)%rc])));
 print("CASE ",mode," source=",D,"x",L," rank=",matrank(M)," left=",lc," right=",rc," normal_rank=",matrank(Q));
 print("NORMAL_MATRIX = ",Q);
 write(out,"# mode ",mode,": 1 rational, 2 characteristic three.");
 if(mode==1,
  write(out,"Add(Cases,[",mode,",",Vec(aa),",",vector(D,i,Vec(M[i,])),",",vector(n,v,vector(D,i,Vec(der[v][i,]))),"]);;"),
  write(out,"Add(Cases,[",mode,",",vector(N,i,if(aa[i]==0,-1,fflog(aa[i],gen,26))),",",vector(D,i,vector(L,j,if(M[i,j]==0,-1,fflog(M[i,j],gen,26)))),",",vector(n,v,vector(D,i,vector(L,j,if(der[v][i,j]==0,-1,fflog(der[v][i,j],gen,26))))),"]);;")
 );
);
print("REFLECTED_NORMAL_COMPLETED");
}
quit;
