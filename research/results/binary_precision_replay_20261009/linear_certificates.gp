default(parisize,64000000);
t='t; u='u; a='a; b='b; c='c;
out="research/results/binary_precision_replay_20261009/linear-certificates.txt";
checks=0; failed=0; certs=0;
newt(q)=3*q^2-2*q^3;
replay_bit_lift(v)={local(w=prod(j=1,#v,1+u*v[j]));sum(j=1,min(3,#v),(-2)^(j-1)*polcoef(w,j,u));};
td(q)=if(q==0,-1,poldegree(subst(subst(subst(q,a,a*t),b,b*t),c,c*t),t));
must(v)={checks++;if(!v,failed++;write(out,"FAILED CHECK ",checks));};
cert(q,cap,label)={
 local(qa,qb,ca,cb,hh);
 qa=subst(q,a,0)+a*(subst(q,a,1)-subst(q,a,0));
 ca=(q-qa)/(a^2-a);
 qb=subst(qa,b,0)+b*(subst(qa,b,1)-subst(qa,b,0));
 cb=(qa-qb)/(b^2-b); hh=qb/8;
 must(denominator(ca,1)==1 && denominator(ca,a)==1 && denominator(ca,b)==1);must(denominator(cb,1)==1 && denominator(cb,a)==1 && denominator(cb,b)==1);must(denominator(hh,1)==1 && denominator(hh,a)==1 && denominator(hh,b)==1);
 must(q-ca*(a^2-a)-cb*(b^2-b)-8*hh==0);
 must(td(q)<=cap);must(td(ca*(a^2-a))<=cap);
 must(td(cb*(b^2-b))<=cap);must(td(8*hh)<=cap);
 certs++;
 write(out,"CERTIFICATE ",label,"; actual degree=",td(q),"; ceiling=",cap);
 write(out,"A=",ca);
 write(out,"B=",cb);
 write(out,"H=",hh);
};
write(out,"Direct parity lift: integer cofactors F=A(a^2-a)+B(b^2-b)+8H; s=3,B_source=2,T=2.");
pp=replay_bit_lift([a,b,a*b]); qq=replay_bit_lift([a*b,a^2*b,a*b^2]); rr=replay_bit_lift([a,b,a^2*b,a*b^2]);
bx=replay_bit_lift([a,b]); by=replay_bit_lift([a*b]);
cert(a*(rr-pp-qq+2*pp*qq),25,"weighted corrected addition");
cert(replay_bit_lift([a^2,b^2,a^2*b,a*b^2])-bx*pp,12,"variable multiplication");
cert(replay_bit_lift([a^2,b^2,a,b]),12,"first source field");
cert(replay_bit_lift([a^2*b^2,a*b]),12,"second source field");
cert(replay_bit_lift([a,a*b])-a*(1-b),6,"old literal axiom");
cert(by^2-by,12,"interpreted idempotent");
must(newt(a)^2-newt(a)-(4*a^2-4*a-3)*(a^2-a)^2==0);
d12=(1-a)*(1-b); d23=(1-b)*(1-c);
num=2-d12*(1+c)-d23*(1+a);
hv=b+a*c-a*b*c; hb=b+a*c+a*b*c;
must(num-2*hv==0);must(num-2*hb+4*a*b*c==0);
write(out,"Half identity numerator=",num,"; Boolean integer target=",hv,"; binary coefficient lift=",hb);
must(lift(Mod(subst(subst(2*bx,a,1),b,0),8))==2);
write(out,"denominator control=",denominator((a+b)/2),"; content=",content((a+b)/2));
must(denominator((a+b)/2,1)==2);
must(lift(Mod(3-2*3,8))==5);
write(out,"certificates=",certs,"; checks=",checks,"; failures=",failed);
if(failed==0 && certs==6 && checks==54,write(out,"PASS"),write(out,"FAIL"));
quit;
