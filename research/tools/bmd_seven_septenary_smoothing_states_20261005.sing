// Shared first-survivor construction for precisely the classes not yet certified by the third source.
// Minimal pole bounds avoid artificial higher-digit states. Global C,X,Y powers are retained.
ring base=7,x,dp;
proc bc(int n,int k,int localModulus){
 int residue=n%localModulus;if(residue<0){residue=residue+localModulus;}
 poly P=(1+t)^residue;return(subst(P/t^k,t,0));
}
proc clip(poly P,int bound){
 poly out=0;int idx;
 for(idx=0;idx<=bound;idx++){out=out+subst(P/t^idx,t,0)*t^idx;}
 return(out);
}
proc calculate(int fieldPrime,int cr){
 ring rr=(fieldPrime,u),(t,C,X,Y),dp;
 int profileKind=-1;
 if(cr%fieldPrime==0){profileKind=0;}
 if(cr%fieldPrime==1){profileKind=1;}
 if((2*cr+1)%fieldPrime==0){profileKind=2;}
 if((2*cr+3)%fieldPrime==0){profileKind=3;}
 if((2*cr-3)%fieldPrime==0){profileKind=4;}
 if(profileKind<0){ERROR("unsupported profile");return();}
 int cref=cr;while(cref<23 || (cref+17)%8!=0){cref=cref+fieldPrime;}
 int alow,blow;list aouts,bouts;
 if(profileKind==0){alow=2*cref;blow=2*cref;aouts=list(2*cref);bouts=list(2*cref);}
 if(profileKind==1){alow=2*cref-1;blow=2*cref+1;aouts=list(2*cref-1,2*cref-2);}
 if(profileKind==2){alow=2*cref;blow=2*cref-1;aouts=list(2*cref+1);bouts=list(2*cref+2,2*cref+1);}
 if(profileKind==3){alow=2*cref+1;blow=2*cref;bouts=list(2*cref+3);}
 if(profileKind==4){alow=2*cref-2;blow=2*cref-3;aouts=list(2*cref-1,2*cref-2,2*cref-3);bouts=list(2*cref,2*cref-1,2*cref-2,2*cref-3);}
 list groups=list(list(2,0,2,4,blow,bouts),list(1,0,3,4,alow,aouts),list(0,3,2,7,alow,aouts),list(1,3,1,7,blow,bouts));
 int MM=0;int kind,ee,peak,lo,hi,maxIndex,localModulus;list group,outs;
 for(kind=1;kind<=4;kind++){
  group=groups[kind];peak=group[1]+group[2]+2*group[5];if(peak>MM){MM=peak;}
  outs=group[6];for(ee=1;ee<=size(outs);ee++){peak=group[3]+group[4]+2*outs[ee];if(peak>MM){MM=peak;}}
 }
 maxIndex=0;
 for(kind=1;kind<=4;kind++){
  group=groups[kind];lo=group[1]+group[2]+2*group[5];hi=MM-((MM-group[1]-group[2])%2);
  if(hi>lo && MM-lo-2>maxIndex){maxIndex=MM-lo-2;}
 }
 localModulus=fieldPrime;while(localModulus<=maxIndex){localModulus=localModulus*fieldPrime;}
 int nr=(8*cr+8)%localModulus;int mr=(4*cr+MM-4*cref)%localModulus;
 int DD=2*MM-(8*cref+8)+1;
 matrix D[DD][DD];matrix R[1][DD];
 int j,k,h,a,row,sg,nw,ex,r,sign,er,isp,phase;
 poly cf,W;number ss=u^2+1/u^2;
 for(sg=0;sg<=1;sg++){
  a=1-2*sg;
  for(j=0;j<DD;j++){D[sg+1,j+1]=a^(j+(MM+1)%2)*((j-mr)*(a-u)+nr*a);}
 }
 for(j=0;j<DD;j++){
  phase=(j-MM)%4;if(phase<0){phase=phase+4;}
  if(phase==0){D[3,j+1]=X;}if(phase==1){D[3,j+1]=Y;}
  if(phase==2){D[3,j+1]=-X;}if(phase==3){D[3,j+1]=-Y;}
 }
 row=3;
 for(kind=1;kind<=4;kind++){
  group=groups[kind];outs=group[6];sign=1;if(kind>=3){sign=-1;}
  hi=MM-((MM-group[1]-group[2])%2);lo=group[1]+group[2]+2*group[5];nw=(hi-lo) div 2;
  if(nw>0){
   matrix F[nw][DD];intvec pivot;
   for(h=1;h<=nw;h++){
    r=MM-hi+2*(h-1);
    for(j=0;j<DD;j++){
     k=r-(DD-1)+j;if(k>=0){F[h,j+1]=bc(nr,k,localModulus)*(-u)^k;}
     k=r-j;if(k>=0){F[h,j+1]=F[h,j+1]+sign*C*bc(nr,k,localModulus)*(-u)^(-k);}
    }
   }
   for(ee=1;ee<=size(outs);ee++){
    peak=group[3]+group[4]+2*outs[ee];k=(hi-peak) div 2+1;
    if(k<1 || k>nw){ERROR("outlier pivot outside window");}
    pivot[size(pivot)+1]=k;er=(2*cr+outs[ee]-2*cref)%fieldPrime;if(er<0){er=er+fieldPrime;}
    W=(1+t)^group[3]*(1-t)^group[4]*(1-ss*t+t^2)^er;
    for(j=1;j<=DD;j++){R[1,j]=F[k,j];}
    for(h=k;h<=nw;h++){
     cf=subst(W/t^(h-k),t,0);
     for(j=1;j<=DD;j++){F[h,j]=F[h,j]-cf*R[1,j];}
    }
   }
   for(h=1;h<=nw;h++){
    isp=0;for(k=1;k<=size(pivot);k++){if(pivot[k]==h){isp=1;}}
    if(isp==0){row++;for(j=1;j<=DD;j++){D[row,j]=F[h,j];}}
   }
   kill F;kill pivot;
  }
 }
 if(row!=DD){ERROR("condition count");}
 print("STATE p="+string(fieldPrime)+" c="+string(cr)+" mod"+string(localModulus)+" D="+string(DD)+" max_index="+string(maxIndex));

 if(det(D)!=0){ERROR("expected boundary defect");}
 matrix LL[1][11];matrix minorD[10][10];int ii,jj,ri,cj;
 for(j=1;j<=11;j++){
  for(ri=1;ri<=10;ri++){for(cj=1;cj<=10;cj++){
   minorD[ri,cj]=D[ri+(ri>=j),cj+1];
  }}
  LL[1,j]=(-1)^(j+1)*det(minorD);
 }
 poly lg=0;for(j=1;j<=11;j++){lg=gcd(lg,LL[1,j]);}
 list divResult;poly quotientPoly;
 for(j=1;j<=11;j++){
  divResult=division(LL[1,j],lg);quotientPoly=divResult[1][1,1];
  if(quotientPoly*lg!=LL[1,j]){ERROR("left quotientPoly");}
  LL[1,j]=quotientPoly;
 }
 matrix verifyLeft=LL*D;
 for(j=1;j<=11;j++){if(verifyLeft[1,j]!=0){ERROR("left kernel");}}
 // Scale the explicit kernel by C, so all later low-tail divisions by C are polynomial.
 poly Qpoly=C*(1-u*t)*(1+t^2)*(u+C*t^7);
 matrix Qvec[11][1];for(j=0;j<=10;j++){Qvec[j+1,1]=subst(Qpoly/t^j,t,0);}
 matrix verifyRight=D*Qvec;
 for(j=1;j<=11;j++){if(verifyRight[j,1]!=0){ERROR("explicit right kernel");}}
 poly Qreverse=0;for(j=0;j<=10;j++){Qreverse=Qreverse+subst(Qpoly/t^j,t,0)*t^(10-j);}
 number half=1;half=half/2;number quarter=1;quarter=quarter/4;
 int state,crState,nLocal,eLocal,shiftE,totalPower,charSign,hh,which;
 poly FP,FM,Hchar,Rhigh,Qh,shape,piece,FoneP,FoneM,polyUp,polyDown,Rpoly,derivativeR;
 poly hUp,hDown,scalarRaw,shifted,normalized,product,scalarFactor;
 matrix residual[2][7];matrix bvec[11][1];matrix rawAnswer[1][1];
 for(state=0;state<7;state++){
  crState=7*state;nLocal=(8*crState+8)%49;
  FP=clip((1-u*t)^nLocal*Qreverse,25);
  FM=clip(C*(1-t/u)^nLocal*Qpoly,25);
  FoneP=0;FoneM=0;
  for(which=1;which<=4;which++){
   if(which==1){a=3;sg=4;charSign=1;}
   if(which==2){a=2;sg=7;charSign=-1;}
   if(which==3){a=2;sg=4;charSign=1;}
   if(which==4){a=1;sg=7;charSign=-1;}
   totalPower=a+sg;
   Hchar=0;
   for(j=0;j<=25;j++){
    if((which<=2 && j%2==0) || (which>=3 && j%2==1)){
     Hchar=Hchar+half*(subst(FP/t^j,t,0)+charSign*subst(FM/t^j,t,0))*t^j;
    }
   }
   for(j=0;j<9-totalPower;j++){
    if(subst(Hchar/t^j,t,0)!=0){ERROR("actual quotientPoly top degree");}
   }
   // Reciprocal-invariant polynomial quotientPoly P/g; its leading degree is 2c.
   Rhigh=clip((Hchar*(1+t^2)^(49-a)*(1-t^2)^(49-sg))/t^(9-totalPower),22);
   for(hh=0;hh<=10;hh++){
    Qh=subst(Rhigh/t^(2*hh),t,0);
    eLocal=(2*crState-hh)%49;if(eLocal<0){eLocal=eLocal+49;}
    shape=clip((1-ss*t^2+t^4)^eLocal,22-2*hh);
    Rhigh=clip(Rhigh-Qh*t^(2*hh)*shape,22);
    shiftE=(eLocal+7)%49;
    piece=clip(-quarter*(eLocal div 7)*Qh*t^(9-totalPower+2*hh)
        *(1+t^2)^a*(1-t^2)^sg*clip((1-ss*t^2+t^4)^shiftE,20),20);
    FoneP=FoneP+piece;FoneM=FoneM+charSign*piece;
   }
   if(clip(Rhigh,21)!=0){ERROR("tau quotientPoly high reconstruction");}
  }
  // Remove only the 14 outer pole levels at each end by an order-N vanishing section.
  polyUp=clip(FoneP*(1-u*t)^((49-nLocal)%49),13);
  quotientPoly=FoneM/C;if(quotientPoly*C!=FoneM){ERROR("low tail C division");}
  polyDown=clip(quotientPoly*(1-t/u)^((49-nLocal)%49),13);
  Rpoly=polyDown;
  for(j=0;j<=13;j++){Rpoly=Rpoly+subst(polyUp/t^j,t,0)*t^(38-j);}
  hUp=clip((1-u*t)^nLocal*polyUp,20);
  hDown=clip(C*(1-t/u)^nLocal*polyDown,20);
  for(j=0;j<=13;j++){
   if(subst((FoneP-hUp)/t^j,t,0)!=0 || subst((FoneM-hDown)/t^j,t,0)!=0){ERROR("outer cancellation");}
  }
  for(j=0;j<=6;j++){
   residual[1,j+1]=subst((FoneP-hUp)/t^(14+j),t,0);
   residual[2,j+1]=subst((FoneM-hDown)/t^(14+j),t,0);
  }
  // L(f0) satisfies the three finite cuts identically. The reduced section has cuts -Phi(h).
  derivativeR=diff(Rpoly,t);
  for(j=0;j<=1;j++){
   a=1-2*j;
   bvec[j+1,1]=-a*((-1+2*u*a)*subst(Rpoly,t,a)+(a-u)*subst(derivativeR,t,a));
  }
  bvec[3,1]=0;
  for(j=0;j<=38;j++){
   phase=(j+1)%4;cf=X;
   if(phase==1){cf=Y;}if(phase==2){cf=-X;}if(phase==3){cf=-Y;}
   bvec[3,1]=bvec[3,1]-subst(Rpoly/t^j,t,0)*cf;
  }
  bvec[4,1]=residual[1,2]+residual[2,2];
  bvec[5,1]=residual[1,6]+residual[2,6]+2*(residual[1,4]+residual[2,4]);
  bvec[6,1]=residual[1,1]+residual[2,1];
  bvec[7,1]=residual[1,5]+residual[2,5]+residual[1,3]+residual[2,3];
  bvec[8,1]=residual[1,7]+residual[2,7]+3*(residual[1,3]+residual[2,3]);
  bvec[9,1]=residual[1,3]-residual[2,3]-2*(residual[1,1]-residual[2,1]);
  bvec[10,1]=residual[1,5]-residual[2,5]-residual[1,1]+residual[2,1];
  bvec[11,1]=residual[1,4]-residual[2,4]-residual[1,2]+residual[2,2];
  rawAnswer=LL*bvec;scalarRaw=rawAnswer[1,1];
  print("STATE c="+string(crState)+" mod49 N="+string(nLocal));
  print("REDUCED DEFORMATION");
  for(j=1;j<=11;j++){print("b"+string(j)+"="+string(bvec[j,1]));}
  if(scalarRaw==0){print("ZERO effective scalar");}
  else{
   print("RAW SCALAR FACTORS");print(factorize(scalarRaw));
   int nzero=nLocal;while(nzero%4!=0){nzero=nzero+49;}
   number aa=1;number bb=0;number tmp;
   for(k=1;k<=nzero;k++){tmp=u*aa+bb;bb=u*bb-aa;aa=tmp;}
   map shift=rr,t,u^nzero*C,aa*X+bb*Y,aa*Y-bb*X;
   shifted=shift(scalarRaw);list fac=factorize(shifted);
   print("SHIFT n0="+string(nzero));print(fac);
   product=1;int alpha=0;
   for(k=1;k<=size(fac[1]);k++){
    product=product*fac[1][k]^fac[2][k];if(fac[1][k]==C){alpha=fac[2][k];}
   }
   if(product!=shifted){ERROR("factorization identity");}
   scalarFactor=fac[1][1];normalized=shifted/(scalarFactor*C^alpha);
   if(normalized*scalarFactor*C^alpha!=shifted){ERROR("normalization identity");}
   string literal=string(normalized);
   ring polynomialRing=7,(u,t,C,X,Y),dp;execute("poly certificate="+literal+";");
   poly origin=subst(subst(subst(subst(certificate,C,0),X,2),Y,0),t,0);
   int auditOrder;poly first=0;
   for(auditOrder=0;auditOrder<49;auditOrder++){first=subst(origin/u^auditOrder,u,0);if(first!=0){break;}}
   string leading=string(first);string back=string(certificate);
   setring rr;execute("poly roundtrip="+back+";");
   if(roundtrip!=normalized){ERROR("polynomial roundtrip");}
   string outcome="CERTIFICATE";if(auditOrder==49){outcome="INCONCLUSIVE";}
   print(outcome+" c="+string(crState)+" modulus=49 n0="+string(nzero)+" C_power="+string(alpha)
     +" scalar="+string(scalarFactor)+" order="+string(auditOrder)+" coefficient="+leading+" polynomial_roundtrip=PASS");
  }
 }
}
calculate(7,0);
quit;
