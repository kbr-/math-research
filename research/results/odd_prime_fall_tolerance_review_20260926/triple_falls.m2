-- Are falls of randomized-prefix members pairwise? (route review: resolvent saturation, nerve)
-- Three blocks, h = 3, t = 1, in the form-value model R = F_3[z]/(z^3 - z). J_b = clauses + (z^3 - z).
-- Statement tested: gr(J1+J2+J3) = gr(J1+J2) + gr(J2+J3) + gr(J1+J3) (falls are generated by
-- pair saturations). Configurations: a chain (b1-b2 and b2-b3 share one form each; path nerve)
-- and a triangle (each pair shares one form; cycle nerve). Constants on shared forms random.
-- Reports lengths of F[z]/(sum of pair grs) and F[z]/gr(triple) (= |P1 cap P2 cap P3|) and the
-- degrees of any excess.
kk = ZZ/3;
out = openOut getenv "TF_OUT";
grIdeal = I -> ideal apply(flatten entries gens gb I, f -> part(first degree f, f));
clauses = (Ls, c) -> (
    gs := apply(Ls, L -> 1 - L^2);
    Q := 1 - (sum(#gs, k -> c#k * gs#k))^2;
    apply(gs, g -> g * Q));
rc = h -> apply(h, k -> random kk);
test = (label, S, Ls) -> (
    boole := ideal apply(gens S, v -> v^3 - v);
    Js := apply(Ls, L -> ideal clauses(L, rc(#L)) + boole);
    pairs := grIdeal(Js#0 + Js#1) + grIdeal(Js#1 + Js#2) + grIdeal(Js#0 + Js#2);
    trip := grIdeal(Js#0 + Js#1 + Js#2);
    top := 2 * numgens S;
    a := apply(toList(0..top), d -> hilbertFunction(d, S / pairs));
    b := apply(toList(0..top), d -> hilbertFunction(d, S / trip));
    pairFall := any({{0,1},{1,2},{0,2}}, p -> (
        g1 := grIdeal(Js#(p#0)) + grIdeal(Js#(p#1)); g2 := grIdeal(Js#(p#0) + Js#(p#1));
        sum(toList(0..top), d -> hilbertFunction(d, S / g1)) != sum(toList(0..top), d -> hilbertFunction(d, S / g2))));
    diff := select(toList(0..top), d -> a#d != b#d);
    out << label << " vars=" << numgens S << " somePairFalls=" << pairFall << " len(pairs)=" << sum a
        << " len(triple)=" << sum b << " tripleFall=" << (a != b) << " degrees=" << toString diff
        << " excess=" << toString(apply(diff, d -> a#d - b#d)) << endl; out << flush);
setRandomSeed 20260926;
for trial from 1 to 4 do (
    S := kk[z_1..z_7, MonomialOrder => GRevLex]; Z := gens S;
    cst := () -> random kk;
    test("chain", S, {{Z#0, Z#1, Z#2}, {Z#0 + cst(), Z#3, Z#4}, {Z#3 + cst(), Z#5, Z#6}});
    T6 := kk[w_1..w_6, MonomialOrder => GRevLex]; W := gens T6;
    test("triangle", T6, {{W#0, W#1, W#2}, {W#0 + cst(), W#3, W#4}, {W#3 + cst(), W#1 + cst(), W#5}}));
close out;
