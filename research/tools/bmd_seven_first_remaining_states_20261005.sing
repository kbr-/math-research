// Full first survivor W=vA+w^3A+v^2B+vw^3B in characteristic three.
// Remaining profiles c=1,3,4 mod9, c=8d-17>=23, N=8c+8.
// Three profile types; nine local states modulo27. Actual C,X,Y retained.
// Stages: finite derivative/value cuts, high-window elimination, exact factors.
ring base=3,x,dp;
proc bc(int n,int k){
 int nr=n%27;if(nr<0){nr=nr+27;}
 poly P=(1+t)^nr;return(subst(P/t^k,t,0));
}
proc calculate(int cr){
 ring rr=(3,u),(t,C,X,Y),dp;
 int typ=cr%9;int cref;
 if(typ==1){cref=55;}if(typ==3){cref=39;}if(typ==4){cref=31;}
 int MM=4*cref+14;int DD=21;int nr=(8*cr+8)%27;int mr=(4*cr+14)%27;
 int alow,blow;list aouts,bouts;
 if(typ==1){alow=2*cref-1;blow=2*cref+1;aouts=list(2*cref-1,2*cref-2);}
 if(typ==3){alow=2*cref+1;blow=2*cref;bouts=list(2*cref+3);}
 if(typ==4){alow=2*cref;blow=2*cref-1;aouts=list(2*cref+1);bouts=list(2*cref+2,2*cref+1);}
 matrix D[DD][DD];matrix R[1][DD];
 int j,k,h,a,row,sg,kind,al,be,oa,ob,low,hi,lo,nw,ex,r,sign,ee,peak,er,isp;
 poly cf,W;number ss=u^2+1/u^2;
 for(sg=0;sg<=1;sg++){
  a=1-2*sg;
  for(j=0;j<DD;j++){
   D[sg+1,j+1]=a^(j+1)*((j-mr)*(a-u)+nr*a);
  }
 }
 for(j=0;j<DD;j++){
  if(j%4==0){D[3,j+1]=X;}if(j%4==1){D[3,j+1]=Y;}
  if(j%4==2){D[3,j+1]=-X;}if(j%4==3){D[3,j+1]=-Y;}
 }
 row=3;
 for(kind=0;kind<=3;kind++){
  sign=1;if(kind>=2){sign=-1;}
  list outs;
  if(kind==0){al=2;be=0;oa=2;ob=4;low=blow;outs=bouts;}
  if(kind==1){al=1;be=0;oa=3;ob=4;low=alow;outs=aouts;}
  if(kind==2){al=0;be=3;oa=2;ob=7;low=alow;outs=aouts;}
  if(kind==3){al=1;be=3;oa=1;ob=7;low=blow;outs=bouts;}
  hi=MM-((MM-al-be)%2);lo=al+be+2*low;nw=(hi-lo) div 2;
  matrix F[nw][DD];intvec pivot;
  for(h=1;h<=nw;h++){
   ex=hi-2*(h-1);r=MM-ex;
   for(j=0;j<DD;j++){
    k=r-(DD-1)+j;if(k>=0){F[h,j+1]=bc(nr,k)*(-u)^k;}
    k=r-j;if(k>=0){F[h,j+1]=F[h,j+1]+sign*C*bc(nr,k)*(-u)^(-k);}
   }
  }
  for(ee=1;ee<=size(outs);ee++){
   peak=oa+ob+2*outs[ee];k=(hi-peak) div 2+1;
   if(k<1 || k>nw){ERROR("outlier pivot outside window");}
   pivot[size(pivot)+1]=k;er=(2*cr+outs[ee]-2*cref)%9;
   W=(1+t)^oa*(1-t)^ob*(1-ss*t+t^2)^er;
   for(j=1;j<=DD;j++){R[1,j]=F[k,j];}
   for(h=k;h<=nw;h++){
    cf=subst(W/t^(h-k),t,0);
    for(j=1;j<=DD;j++){F[h,j]=F[h,j]-cf*R[1,j];}
   }
  }
  for(h=1;h<=nw;h++){
   isp=0;for(k=1;k<=size(pivot);k++){if(pivot[k]==h){isp=1;}}
   if(isp==0){row++;for(j=1;j<=DD;j++){D[row,j]=F[h,j];}}
  }
  kill F;kill pivot;kill outs;
 }
 if(row!=DD){ERROR("condition count");}
 print("STATE c="+string(cr)+" mod27; N="+string(nr)+"; rows="+string(row));
 poly detD=det(D);
 if(detD==0){print("ZERO: full formal determinant");return();}
 list fac=factorize(detD);print("RAW FACTORS:");print(fac);
 poly product=1;
 for(k=1;k<=size(fac[1]);k++){product=product*fac[1][k]^fac[2][k];}
 if(product!=detD){ERROR("factor identity");}
 print("PASS exact factorization");
 int nzero=nr;while(nzero%4!=0){nzero=nzero+27;}
 number aa=1;number bb=0;number tmp;
 for(k=1;k<=nzero;k++){tmp=u*aa+bb;bb=u*bb-aa;aa=tmp;}
 map shift=rr,t,u^nzero*C,aa*X+bb*Y,aa*Y-bb*X;
 poly shifted=shift(detD);fac=factorize(shifted);
 print("SHIFT n0="+string(nzero));print(fac);
 map atOrigin=rr,t,0,2,0;poly one;
 product=1;
 for(k=1;k<=size(fac[1]);k++){
  one=fac[1][k];product=product*one^fac[2][k];print("ORIGIN "+string(k)+": "+string(atOrigin(one)));
 }
 if(product!=shifted){ERROR("shifted factor identity");}
 print("PASS exact shifted factorization");
 int alpha=5;if(typ==1 || typ==3){alpha=7;}
 poly scalar=fac[1][1];
 if(deg(scalar)!=0 || scalar==0){ERROR("nonzero scalar factor required");}
 poly normalized=shifted/(scalar*C^alpha);
 if(scalar*C^alpha*normalized!=shifted){ERROR("normalized identity");}
 string literal=string(normalized);
 ring polynomialRing=3,(u,t,C,X,Y),dp;
 execute("poly certificate="+literal+";");
 poly origin=subst(subst(subst(subst(certificate,C,0),X,2),Y,0),t,0);
 int order=0;if(typ==3){order=1;}
 poly leadingCoefficient=subst(origin/u^order,u,0);
 if(leadingCoefficient!=-1 || (order==1 && subst(origin,u,0)!=0)){ERROR("low-degree certificate mismatch");}
 string leading=string(leadingCoefficient);string back=string(certificate);
 setring rr;
 execute("poly roundtrip="+back+";");
 if(roundtrip!=normalized){ERROR("polynomial roundtrip lost rational coefficients");}
 print("CERTIFICATE c="+string(cr)+" n0="+string(nzero)+" C_power="+string(alpha)
       +" scalar="+string(scalar)+" order="+string(order)+" coefficient="+leading+" polynomial_roundtrip=PASS");
}
int cr;
for(cr=0;cr<27;cr++){
 if(cr%9==1 || cr%9==3 || cr%9==4){calculate(cr);}
}
quit;
