// Only the five templates whose constant-origin test was inconclusive.
ring R=3,(u,c,x,y),dp;
proc lowbin(int n,int k){n=n%9;if(k<0 || k>n){return(0);}int v=1;int h;for(h=1;h<=k;h++){v=v*(n-h+1) div h;}return(v);}
proc assess_template(matrix B,int d,int smallestN){
 if(d==7 || d==9 || d==11){return();}
 poly om=det(B);if(om==0){ERROR("unexpected zero template");return();}
 poly rest=om;int cp=0;while(subst(rest,c,0)==0){rest=rest/c;cp++;}
 poly low=subst(rest,c,0);int up=0;while(subst(low,u,0)==0){low=low/u;up++;}
 poly powerX=0;poly powerY=0;int h;
 for(h=0;h<=4;h++){powerX=powerX+2*(-1)^h*lowbin(smallestN,2*h)*u^(2*h);}
 for(h=0;h<=3;h++){powerY=powerY-2*(-1)^h*lowbin(smallestN,2*h+1)*u^(2*h+1);}
 map local_power=R,u,0,powerX,powerY;
 poly probe=local_power(low);int vp=0;
 print("CASE dmod9="+string(d%9)+" representative="+string(d)+" size="+string(nrows(B)));
 print("X_MOD_U9="+string(powerX));print("Y_MOD_U9="+string(powerY));
 print("LOCAL_NORMALIZED_COEFFICIENT="+string(probe));
 if(probe==0){ERROR("local coefficient unresolved");return();}
 while(subst(probe,u,0)==0){probe=probe/u;vp++;}
 poly co=subst(probe,u,0);
 print("C_POWER="+string(cp)+" U_POWER="+string(up)+" LOCAL_ORDER="+string(vp)+" COEFFICIENT="+string(co));
 if(vp>=9 || up+vp>=smallestN){ERROR("actual-power error bound insufficient");return();}
 print("PASS_ACTUAL_POWERS: low digit error starts at9; next global-power term starts atN");
}
execute(read("research/results/bmd-eight-bulk-templates-20261006/global-matrices.sing"));
print("DONE five remaining nonzero templates certified");
quit;
