{"event": "run_start", "monotonic_s": 829027.330022838, "unix_s": 1791763665.267793, "id": "9d9535350e", "category": "local_processing", "command": ["python3", "-c", "\nimport json, math\nfrom math import comb, log\nrows=[json.loads(l) for l in open('research/results/near-half-majority-degree-20261012/sizing.jsonl')]\nprint(len(rows),'instances;', sorted({(r['w'],r['n']) for r in rows}))\nprint('degree equals k+1 in', sum(r['exact_degree']==r['w']//2+1 for r in rows),'; within point bound', sum(r['degree_within_point_bound'] for r in rows),'; monotone', sum(1 for r in rows if r.get('monotone')), 'of', sum(1 for r in rows if 'monotone' in r))\nprint('point bounds', min(r['point_bound'] for r in rows), 'to', max(r['point_bound'] for r in rows), '; draws total', sum(r['draws'] for r in rows), '; memory flag false in', sum(not r['memory_within_estimate'] for r in rows), 'peak there', sorted({r['peak_bytes'] for r in rows if not r['memory_within_estimate']}))\ndef E(w,n): k=w//2; m=n+1; return (m*m/4)*comb(w,k+1)**2/comb(n,k+1)\nfor w,ns in ((5,(14,16,18,22,24,150,300,1000)),(7,(14,18,22,86,200,1000)),(19,(1900,))):\n    print('w',w,'expected coincidences bound', {n: float('%.3g'%E(w,n)) for n in ns}, 'least n with bound below 1:', next(n for n in range(w,10**6) if E(w,n)<1))\nfor w,n in ((5,150),(5,300),(7,86),(7,200)):\n    k=w//2; print('w',w,'n',n,'monomials through degree k+3:', sum(comb(n,j) for j in range(k+4)))\nn,w,m1=1900,19,900\nprint('first moment lower bound, ln:', round(-2*log(n/2+1)-log(2)+m1*log(1+1/(w+1)),1), 'with m_1 =',m1)\n"], "output": "logs/nhpc-20261012-majority-degree-test-9d9535350e.output.txt", "cwd": "/home/kbr/dev/math/.claude/worktrees/near-half-pc-degree", "systemd_unit": "mathcompute-job-63c34b268dc34cc4b8a5b7c359c1bb1a.service", "threads": 1, "timeout_s": 60.0, "expect_s": null, "serial_reason": "", "kernel_reason": "", "user_approved": ""}
