{"event": "run_start", "monotonic_s": 134922.241335285, "unix_s": 1792277401.1828296, "id": "25d38bd795", "category": "computation", "command": ["env", "PYTHONPATH=research/results/ultimate_matching_box_completion_20261018", "python3", "-c", "\nimport math,json,numpy as np\nimport box_completion as b\nout=[]\nfor N in (4096,16384):\n  for seed in range(3):\n    rng=np.random.default_rng(7000+N+seed); X=rng.uniform(0,1,(N,2)); g=int(math.isqrt(N))\n    cells=np.stack(np.meshgrid(np.arange(g),np.arange(g),indexing='ij'),-1).reshape(-1,2); Y=(cells+rng.uniform(0,1,(N,2)))/g\n    s1=math.sqrt(math.log(N)/N); A1=b.graph(X,Y,0.5*s1); m1=N-int((b.maximum_bipartite_matching(A1)>=0).sum())\n    for c in (2,4,8,16):\n      Ac=b.graph(X,Y,0.5*c**0.25*s1); mc=N-int((b.maximum_bipartite_matching(Ac)>=0).sum())\n      _,det=b.certificate(A1,Ac); r=dict(N=N,seed=seed,c=c,m1=m1,mc=mc,cert=det['cert'],nuD=det['nuD'],BX=det['BX'],nuBX=det['nuBX'],BY=det['BY'],nuBY=det['nuBY'])\n      out.append(r); print(r,flush=True)\njson.dump(out,open('research/results/ultimate_matching_box_completion_20261018/level_ratio_smallest.json','w'),indent=1)\n"], "output": "logs/um-completion-25d38bd795.output.txt", "cwd": "/home/kbr/dev/math/.claude/worktrees/talagrand", "systemd_unit": "mathcompute-job-a6da412d6d934501be8b47db7e635248.service", "threads": 1, "timeout_s": 110.0, "expect_s": 60.0, "serial_reason": "", "kernel_reason": "", "user_approved": ""}
