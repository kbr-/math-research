// c mod p = 1, alternative, p>19; N mod p=16.
ring rr=(0,u),(t,C,X,Y,U,V),dp;
proc bc(int n,int k){number ans=1;int ii;for(ii=1;ii<=k;ii++){ans=ans*(n-ii+1)/ii;}return(ans);}
matrix D[5][5];matrix R[1][5];
number ss=u^2+1/u^2;
int j,k,h;poly W,cf;
D[1,1]=U;
D[2,1]=((-10)*(1-u^2)+(16))*U+(16)*u*V;
D[3,1]=-X;
D[1,2]=V;
D[2,2]=((-9)*(1-u^2)+(16))*V+(16)*u*U;
D[3,2]=-Y;
D[1,3]=U;
D[2,3]=((-8)*(1-u^2)+(16))*U+(16)*u*V;
D[3,3]=X;
D[1,4]=V;
D[2,4]=((-7)*(1-u^2)+(16))*V+(16)*u*U;
D[3,4]=Y;
D[1,5]=U;
D[2,5]=((-6)*(1-u^2)+(16))*U+(16)*u*V;
D[3,5]=-X;
matrix F1[3][5];
F1[1,1]=(1)*C*bc(16,1)*(-u)^(-1);
F1[1,2]=(1)*C*bc(16,0)*(-u)^(-0);
F1[1,4]=bc(16,0)*(-u)^(0);
F1[1,5]=bc(16,1)*(-u)^(1);
F1[2,1]=(1)*C*bc(16,3)*(-u)^(-3);
F1[2,2]=bc(16,0)*(-u)^(0)+(1)*C*bc(16,2)*(-u)^(-2);
F1[2,3]=bc(16,1)*(-u)^(1)+(1)*C*bc(16,1)*(-u)^(-1);
F1[2,4]=bc(16,2)*(-u)^(2)+(1)*C*bc(16,0)*(-u)^(-0);
F1[2,5]=bc(16,3)*(-u)^(3);
F1[3,1]=bc(16,1)*(-u)^(1)+(1)*C*bc(16,5)*(-u)^(-5);
F1[3,2]=bc(16,2)*(-u)^(2)+(1)*C*bc(16,4)*(-u)^(-4);
F1[3,3]=bc(16,3)*(-u)^(3)+(1)*C*bc(16,3)*(-u)^(-3);
F1[3,4]=bc(16,4)*(-u)^(4)+(1)*C*bc(16,2)*(-u)^(-2);
F1[3,5]=bc(16,5)*(-u)^(5)+(1)*C*bc(16,1)*(-u)^(-1);
W=0;for(k=0;k<=3;k++){W=W+bc(1,k)*(-ss*t+t^2)^k;}
W=(1+t)^3*(1-t)^4*W;
for(j=1;j<=5;j++){R[1,j]=F1[1,j];}
for(h=1;h<=3;h++){cf=subst(W/t^(h-1),t,0);for(j=1;j<=5;j++){F1[h,j]=F1[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=3;k++){W=W+bc(0,k)*(-ss*t+t^2)^k;}
W=(1+t)^3*(1-t)^4*W;
for(j=1;j<=5;j++){R[1,j]=F1[2,j];}
for(h=2;h<=3;h++){cf=subst(W/t^(h-2),t,0);for(j=1;j<=5;j++){F1[h,j]=F1[h,j]-cf*R[1,j];}}
for(j=1;j<=5;j++){D[4,j]=F1[3,j];}
matrix F2[3][5];
F2[1,1]=(-1)*C*bc(16,1)*(-u)^(-1);
F2[1,2]=(-1)*C*bc(16,0)*(-u)^(-0);
F2[1,4]=bc(16,0)*(-u)^(0);
F2[1,5]=bc(16,1)*(-u)^(1);
F2[2,1]=(-1)*C*bc(16,3)*(-u)^(-3);
F2[2,2]=bc(16,0)*(-u)^(0)+(-1)*C*bc(16,2)*(-u)^(-2);
F2[2,3]=bc(16,1)*(-u)^(1)+(-1)*C*bc(16,1)*(-u)^(-1);
F2[2,4]=bc(16,2)*(-u)^(2)+(-1)*C*bc(16,0)*(-u)^(-0);
F2[2,5]=bc(16,3)*(-u)^(3);
F2[3,1]=bc(16,1)*(-u)^(1)+(-1)*C*bc(16,5)*(-u)^(-5);
F2[3,2]=bc(16,2)*(-u)^(2)+(-1)*C*bc(16,4)*(-u)^(-4);
F2[3,3]=bc(16,3)*(-u)^(3)+(-1)*C*bc(16,3)*(-u)^(-3);
F2[3,4]=bc(16,4)*(-u)^(4)+(-1)*C*bc(16,2)*(-u)^(-2);
F2[3,5]=bc(16,5)*(-u)^(5)+(-1)*C*bc(16,1)*(-u)^(-1);
W=0;for(k=0;k<=3;k++){W=W+bc(1,k)*(-ss*t+t^2)^k;}
W=(1+t)^2*(1-t)^5*W;
for(j=1;j<=5;j++){R[1,j]=F2[1,j];}
for(h=1;h<=3;h++){cf=subst(W/t^(h-1),t,0);for(j=1;j<=5;j++){F2[h,j]=F2[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=3;k++){W=W+bc(0,k)*(-ss*t+t^2)^k;}
W=(1+t)^2*(1-t)^5*W;
for(j=1;j<=5;j++){R[1,j]=F2[2,j];}
for(h=2;h<=3;h++){cf=subst(W/t^(h-2),t,0);for(j=1;j<=5;j++){F2[h,j]=F2[h,j]-cf*R[1,j];}}
for(j=1;j<=5;j++){D[5,j]=F2[3,j];}
print("dimension=5; maximum high depth=5");
poly detD=det(D);
poly AA=(1)*u^0+(-120)*u^2+(1820)*u^4+(-8008)*u^6+(12870)*u^8+(-8008)*u^10+(1820)*u^12+(-120)*u^14+(1)*u^16;poly BB=(16)*u^1+(-560)*u^3+(4368)*u^5+(-11440)*u^7+(11440)*u^9+(-4368)*u^11+(560)*u^13+(-16)*u^15;poly GG=(1)*u^0+(120)*u^2+(1820)*u^4+(8008)*u^6+(12870)*u^8+(8008)*u^10+(1820)*u^12+(120)*u^14+(1)*u^16;poly HH=(-16)*u^1+(-560)*u^3+(-4368)*u^5+(-11440)*u^7+(-11440)*u^9+(-4368)*u^11+(-560)*u^13+(-16)*u^15;
map shift=rr,t,u^(16)*C,(AA*X+BB*Y)/(1),(AA*Y-BB*X)/(1),(GG*U+HH*V)/(1),(HH*U+GG*V)/(1);
detD=shift(detD);
print("case 1");

if(detD==0){ERROR("zero determinant");}
list fac=factorize(detD);
poly product=1;int ff;
for(ff=1;ff<=size(fac[1]);ff++){product=product*fac[1][ff]^fac[2][ff];}
if(product!=detD){ERROR("factor product mismatch");}
map atPowerOrigin=rr,t,0,2,0,2,0;
poly oneFactor;poly value;string encoded;string decoded;
ring integral=integer,(u,t,C,X,Y,U,V),dp;
setring rr;
for(ff=2;ff<=size(fac[1]);ff++){
 oneFactor=fac[1][ff];
 encoded=string(oneFactor);
 setring integral;
 execute("poly integralPolynomial="+encoded+";");
 decoded=string(integralPolynomial);
 kill integralPolynomial;
 setring rr;
 execute("poly roundTrip="+decoded+";");
 if(roundTrip!=oneFactor){ERROR("factor is not integral");}
 kill roundTrip;
}
oneFactor=fac[1][2];value=atPowerOrigin(oneFactor);
poly expected=(4899729120u52+81913420160u50-840355510904u48-72906411443008u46-407830616241568u44+1069174816131136u42+15107782188934032u40+26190049513986112u38-37923911089345216u36-143145454867527616u34-78377333337517448u32+71184106370089856u30+82827491027431872u28+14646695700486784u26-5780045077990432u24-2376866196327296u22-167232168254368u20+9370053942784u18+1707255314168u16-360385004608u14-69642289184u12+385372480u10-61859440u8-1722560u6-15488u4+3136u2+8);
if(value!=expected){ERROR("origin coefficient certificate differs");}
print("PASS: integral polynomial round trips and origin certificate");
quit;
