{"event": "run_start", "monotonic_s": 1065936.663804489, "unix_s": 1792000574.6015744, "id": "37fce518c5", "category": "local_processing", "command": ["env", "PYTHONPATH=tools", "python3", "-c", "import json, re, time\nfrom pathlib import Path\nfrom importlib.machinery import SourceFileLoader\nfrom notebooks import selected\nft = SourceFileLoader(\"disposition_measure\", \"tools/finish-turn.py\").load_module()\nbad = Path(\"research/tmp/codex/0116b2de761f162a30a9dfa5c6a455ad73ce0c6f0399f3b8fb3bb7f8aaac193b/goal_test_old.txt\").read_text()\nfor name in (\"main\", \"binary-multiplicity-degree\"):\n    path = Path(selected(name)[\"source\"])\n    body = path.read_text()\n    reviews = [m for m in re.finditer(r\"\"\"<article\\b([^>]*)>(.*?)</article>\"\"\", body, re.S) if \"data-kind=\"+chr(34)+\"review\"+chr(34) in m.group(1) and \"<strong>Decisive test.</strong>\" in m.group(2)]\n    anchor = re.search(r\"\"\"\\bid=\"([^\"]+)\"\"\"\", reviews[-1].group(1)).group(1)\n    value = \"<strong>Test disposition.</strong> Retained exploratory: <a href=\"+chr(34)+\"#\"+anchor+chr(34)+\">Earlier unresolved test</a>.\"\n    start = time.perf_counter()\n    ft.validate_test_disposition(body, len(body), value)\n    valid_seconds = time.perf_counter() - start\n    start = time.perf_counter()\n    try:\n        ft.validate_test_disposition(body, len(body), bad)\n    except ValueError as error:\n        refused = str(error)\n    else:\n        raise AssertionError(\"The actual unsupported review draft was accepted\")\n    print(json.dumps({\"notebook\": name, \"source\": str(path), \"files\": 1, \"bytes\": path.stat().st_size, \"record_tags\": len(re.findall(r\"<article\\b\", body)), \"retained_check_seconds\": valid_seconds, \"actual_bad_draft_seconds\": time.perf_counter()-start, \"bad_draft_refusal\": refused}))\n"], "output": "logs/ac2-pang-goal-review-20261014-37fce518c5.output.txt", "cwd": "/home/kbr/dev/math-auxiliary", "systemd_unit": "mathcompute-job-7113d59911534a59ac95a1a2