// Derksen-Sidman lead: ideal of Z = union of the six affine lines {x_i = 0, x_j = 2} (i != j) in A^3 over F_3,
// the common zero set of the three-shift pair C = xyz, C' = (x+1)(y+1)(z+1). Is the binomial w = C - C' a
// minimal generator, and in which degrees is the ideal generated (with and without the field equations)?
ring r = 3,(x,y,z),dp;
ideal L1 = x, y-2; ideal L2 = x, z-2; ideal L3 = y, x-2; ideal L4 = y, z-2; ideal L5 = z, x-2; ideal L6 = z, y-2;
ideal I = intersect(L1,L2,L3,L4,L5,L6);
ideal M = minbase(I);
print("minimal generators of I(Z) over the closure:"); print(M);
poly w = x*y*z - (x+1)*(y+1)*(z+1);
print("w reduces to 0 mod I:"); print(reduce(w, std(I)) == 0);
ideal F = x3-x, y3-y, z3-z;
ideal J = std(I + F);
print("degree-<=2 part: w in ideal generated by I's elements of degree <= 2 plus field equations?");
ideal low; int i; for (i=1; i<=ncols(M); i++) { if (deg(M[i]) <= 2) { low = low, M[i]; } }
print(low);
exit;
