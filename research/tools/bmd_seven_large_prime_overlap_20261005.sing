F3[6,6]=(-1)*C*bc(-4,5)*(-u)^(-5);
F3[6,7]=(-1)*C*bc(-4,4)*(-u)^(-4);
F3[6,8]=(-1)*C*bc(-4,3)*(-u)^(-3);
F3[6,9]=(-1)*C*bc(-4,2)*(-u)^(-2);
F3[6,10]=(-1)*C*bc(-4,1)*(-u)^(-1);
F3[6,11]=bc(-4,0)*(-u)^(0)+(-1)*C*bc(-4,0)*(-u)^(-0);
F3[6,12]=bc(-4,1)*(-u)^(1);
F3[6,13]=bc(-4,2)*(-u)^(2);
F3[6,14]=bc(-4,3)*(-u)^(3);
F3[6,15]=bc(-4,4)*(-u)^(4);
F3[6,16]=bc(-4,5)*(-u)^(5);
F3[6,17]=bc(-4,6)*(-u)^(6);
F3[6,18]=bc(-4,7)*(-u)^(7);
F3[6,19]=bc(-4,8)*(-u)^(8);
F3[6,20]=bc(-4,9)*(-u)^(9);
F3[6,21]=bc(-4,10)*(-u)^(10);
F3[7,1]=(-1)*C*bc(-4,12)*(-u)^(-12);
F3[7,2]=(-1)*C*bc(-4,11)*(-u)^(-11);
F3[7,3]=(-1)*C*bc(-4,10)*(-u)^(-10);
F3[7,4]=(-1)*C*bc(-4,9)*(-u)^(-9);
F3[7,5]=(-1)*C*bc(-4,8)*(-u)^(-8);
F3[7,6]=(-1)*C*bc(-4,7)*(-u)^(-7);
F3[7,7]=(-1)*C*bc(-4,6)*(-u)^(-6);
F3[7,8]=(-1)*C*bc(-4,5)*(-u)^(-5);
F3[7,9]=bc(-4,0)*(-u)^(0)+(-1)*C*bc(-4,4)*(-u)^(-4);
F3[7,10]=bc(-4,1)*(-u)^(1)+(-1)*C*bc(-4,3)*(-u)^(-3);
F3[7,11]=bc(-4,2)*(-u)^(2)+(-1)*C*bc(-4,2)*(-u)^(-2);
F3[7,12]=bc(-4,3)*(-u)^(3)+(-1)*C*bc(-4,1)*(-u)^(-1);
F3[7,13]=bc(-4,4)*(-u)^(4)+(-1)*C*bc(-4,0)*(-u)^(-0);
F3[7,14]=bc(-4,5)*(-u)^(5);
F3[7,15]=bc(-4,6)*(-u)^(6);
F3[7,16]=bc(-4,7)*(-u)^(7);
F3[7,17]=bc(-4,8)*(-u)^(8);
F3[7,18]=bc(-4,9)*(-u)^(9);
F3[7,19]=bc(-4,10)*(-u)^(10);
F3[7,20]=bc(-4,11)*(-u)^(11);
F3[7,21]=bc(-4,12)*(-u)^(12);
W=0;for(k=0;k<=7;k++){W=W+bc(2,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=21;j++){R[1,j]=F3[1,j];}
for(h=1;h<=7;h++){cf=subst(W/t^(h-1),t,0);for(j=1;j<=21;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=7;k++){W=W+bc(1,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=21;j++){R[1,j]=F3[2,j];}
for(h=2;h<=7;h++){cf=subst(W/t^(h-2),t,0);for(j=1;j<=21;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=7;k++){W=W+bc(0,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=21;j++){R[1,j]=F3[3,j];}
for(h=3;h<=7;h++){cf=subst(W/t^(h-3),t,0);for(j=1;j<=21;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
for(j=1;j<=21;j++){D[18,j]=F3[4,j];}
for(j=1;j<=21;j++){D[19,j]=F3[5,j];}
for(j=1;j<=21;j++){D[20,j]=F3[6,j];}
for(j=1;j<=21;j++){D[21,j]=F3[7,j];}
print("dimension=21; maximum high depth=12");


string serialized=string(D);
ring check=(7,u),(t,C,X,Y,U,V),dp;
execute("matrix newD[21][21]="+serialized+";");
ring old=(7,u),(t,C,X,Y,U,V),dp;
number ss=u^2+1/u^2;
matrix D[21][21];matrix R[1][21];
int j,r,k,kind,row,ex,peak,h,a,b,lo,hi,nw,emin,emax,ee,sign,isp;
poly W,cf;
poly BN=(1+t)^3*(1+t^7)^6;
for(j=0;j<=20;j++)
{
 if(j%2==0){D[1,j+1]=U;}else{D[1,j+1]=V;}
 if(j%2==0){cf=V;}else{cf=U;}
 D[2,j+1]=((j-1)*(1-u^2)+3)*D[1,j+1]+3*u*cf;
 if(j%4==0){D[3,j+1]=X;}
 if(j%4==1){D[3,j+1]=Y;}
 if(j%4==2){D[3,j+1]=-X;}
 if(j%4==3){D[3,j+1]=-Y;}
}
row=3;
for(kind=0;kind<=3;kind++)
{
 sign=1;
 if(kind==0){a=2;b=2;lo=92;hi=106;emin=49;emax=51;}
 if(kind==1){a=1;b=0;lo=95;hi=105;emin=1;emax=0;}
 if(kind==2){a=0;b=1;lo=95;hi=105;emin=1;emax=0;sign=-1;}
 if(kind==3){a=1;b=3;lo=92;hi=106;emin=49;emax=51;sign=-1;}
 nw=(hi-lo) div 2;
 matrix F[nw][21];intvec pivot;
 for(h=1;h<=nw;h++)
 {
  ex=hi-2*(h-1);r=106-ex;
  for(j=0;j<=20;j++)
  {
   k=r-20+j;
   if(k>=0 && k<=12){cf=subst(BN/t^k,t,0);F[h,j+1]=cf*(-u)^k;}
   k=r-j;
   if(k>=0 && k<=12){cf=subst(BN/t^k,t,0);F[h,j+1]=F[h,j+1]+sign*C*cf*(-u)^(-k);}
  }
 }
 for(ee=emax;ee>=emin;ee--)
 {
  peak=a+b+2*ee;k=(hi-peak) div 2+1;pivot[size(pivot)+1]=k;
  W=(1+t)^a*(1-t)^b*(1-ss*t+t^2)^(ee%7);
  for(j=1;j<=21;j++){R[1,j]=F[k,j];}
  for(h=k;h<=nw;h++)
  {
   cf=subst(W/t^(h-k),t,0);
   for(j=1;j<=21;j++){F[h,j]=F[h,j]-cf*R[1,j];}
  }
 }
 for(h=1;h<=nw;h++)
 {
  isp=0;for(k=1;k<=size(pivot);k++){if(pivot[k]==h){isp=1;}}
  if(isp==0){row++;for(j=1;j<=21;j++){D[row,j]=F[h,j];}}
 }
 kill F;kill pivot;
}
print("rows="+string(row));

matrix newD=imap(check,newD);
int jj,kk;int bad=0;
for(jj=1;jj<=21;jj++){
 for(kk=1;kk<=21;kk++){
  if(jj==3){newD[jj,kk]=-newD[jj,kk];}
  if(newD[jj,kk]!=D[jj,kk]){bad++;print("diff row="+string(jj)+" col="+string(kk));print(newD[jj,kk]);print(D[jj,kk]);}
 }
}
if(bad!=0){ERROR("overlap mismatch");}else{print("PASS: every entry matches the independent septenary matrix");}
quit;
