-- Hilbert functions of quotients of the exterior algebra in characteristic two by products of two
-- random linear forms, against the product series.
-- Statement computed (side notebook near-half-pc-degree, entry-2026-10-09-many-dependency-series):
-- A = F[x_1..x_n]/(x_i^2), F = GF(q), q = 2 or 8; I generated by m products l_i l_i' of random linear
-- forms.  For each case print the Hilbert function of A/I in all degrees and the coefficients of
-- P(z) = (1+z)^(n-2m) (1+2z)^m, and the first degree where they differ ("first_diff", -1 if none up
-- to the first non-positive coefficient of P, whose degree is "index").  Tested hypothesis: for
-- random forms over GF(8) the Hilbert function equals P below its index.  The number of linear
-- dependencies among the 2m forms is 2m - n when positive.  Seeds fixed; exact arithmetic.
series = (n,m) -> (
    c := apply(n+1, j -> binomial(m,j)*2^j);
    e := n - 2*m;
    b := apply(n+1, j -> if e >= 0 then binomial(e,j) else (-1)^j*binomial(-e+j-1,j));
    apply(n+1, j -> sum(j+1, i -> c#i*b#(j-i))));
run1 = (q,n,m,seed) -> (
    setRandomSeed seed;
    F := if q == 2 then ZZ/2 else GF q;
    S := F[x_1..x_n];
    R := S/ideal apply(gens S, v -> v^2);
    I := ideal apply(m, i -> random(1,R)*random(1,R));
    h := apply(n+1, j -> hilbertFunction(j, R/I));
    p := series(n,m);
    idx := position(p, v -> v <= 0); if idx === null then idx = n+1;
    d := position(toList(0..idx-1), j -> h#j != p#j); if d === null then d = -1;
    print concatenate("q=",toString q," n=",toString n," m=",toString m," seed=",toString seed,
        " deps=",toString max(2*m-n,0)," index=",toString idx," first_diff=",toString d,
        " hf=",toString h," series=",toString take(p, min(idx+1,n+1)));
    );
cases = {(8,5),(8,6),(8,7),(8,10),(8,16),(8,24),(10,6),(10,7),(10,8),(10,12),(10,20),(10,30),
         (12,7),(12,8),(12,9),(12,12),(12,18),(12,30),(14,8),(14,9),(14,10),(14,14),(14,28)};
scan(cases, c -> scan({8,2}, q -> scan({1,2}, s -> run1(q, c#0, c#1, s))));
