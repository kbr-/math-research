// [fibre over y = 7/3, directions mu symbolic] Exceptional fibres of the N = 5 graph closure over the two-double-root line (29 September 2026; route review
// bmd-20260929-zzi, falsification attempt for (F_rel) of thm:cube-contact-relative-transfer). Configurations
// a = (0, mu t, 1, 1 + t, y) approach the line a_1 = a_2, a_3 = a_4 with ratio (a_2 - a_1):(a_4 - a_3) = mu. The flat limit
// of the row space of A_M (rows H_k(a_i,a_j), all ten pairs) as t -> 0 is computed over F_p(mu, y), p = 32003, by
// saturating the row module in t and setting t = 0; generators are cleared of denominators and mapped to F_p[mu, y],
// then saturated at every factor of the resulting contact polynomial (degenerate generators give spurious contact).
// Tested statement ((F_rel) on the exceptional component, dimension 2, and its fibre curves): the limit spaces over the
// line have no contact, i.e. the 10x10 minors on columns 0..R+1 generate the unit ideal after saturation by the
// collision forms mu, y, y - 1. A proper contact ideal whose zeros are genuine limits refutes (F_rel) as stated.
// Controls: generic rank 10 of the limit at (mu, y) = (5, 7/3); weight-one control on columns 0..R-1 proper.
LIB "elim.lib";
int R = 10; int M = 20;
ring rp = (32003, mu), (t), dp; number y = 7/3;
proc hcoef(int m) { number c = 1; int i; for (i = 1; i <= m; i++) { c = c * (-3/2 - (i - 1)) / i; } return(c); }
proc Hk(poly X, poly Y, int k) { poly s = 0; int q; for (q = 0; q <= k; q++) { s = s + hcoef(q) * hcoef(k - q) * X^q * Y^(k - q); } return(s); }
list pts = 0, mu * t, 1, 1 + t, y;
matrix A[R][M + 1];
int row = 0; int i; int j; int k;
for (i = 1; i <= 5; i++) { for (j = i + 1; j <= 5; j++) { row++; for (k = 0; k <= M; k++) { A[row, k + 1] = Hk(pts[i], pts[j], k); } } }
module Mo = module(transpose(A));
def S = sat(std(Mo), ideal(t)); module L; if (typeof(S) == "list") { L = S[1]; } else { L = S; }
L = subst(L, t, 0);
for (i = 1; i <= size(L); i++) { L[i] = cleardenom(L[i]); }
ring rq = 32003, (mu, t), dp;
module L = imap(rp, L);
proc satid(ideal I, poly g) { def S = sat(std(I), ideal(g)); ideal J; if (typeof(S) == "list") { J = S[1]; } else { J = S; } return(std(J)); }
poly coll = mu;
proc contactideal(module L) { matrix G = transpose(matrix(L)); matrix G12 = submat(G, 1..nrows(G), 1..(R + 2)); return(satid(minor(G12, R), coll)); }
matrix G = transpose(matrix(L));
matrix Gn = subst(G, mu, 5);
print("limit generators: " + string(nrows(G)) + "; rank at (mu, y) = (5, 7/3): " + string(rank(Gn)));
matrix G10 = submat(G, 1..nrows(G), 1..R);
ideal w1 = satid(minor(G10, R), coll);
print("weight-one control proper: " + string(w1[1] != 1));
ideal cont = contactideal(L);
print("contact ideal before saturation of the module: dimension " + string(dim(cont)) + ", unit: " + string(cont[1] == 1));
int round = 0;
while (cont[1] != 1 && round < 3) {
  round++;
  ideal pr = cont; list fa = factorize(pr[1]);
  for (i = 1; i <= size(fa[1]); i++) { if (deg(fa[1][i]) > 0) { def S2 = sat(std(L), ideal(fa[1][i])); if (typeof(S2) == "list") { L = S2[1]; } else { L = S2; } kill S2; } }
  cont = contactideal(L);
  print("after saturation round " + string(round) + ": contact ideal dimension " + string(dim(cont)) + ", unit: " + string(cont[1] == 1) + ", generators: " + string(size(cont)));
  kill pr; kill fa;
}
if (cont[1] != 1) { print("remaining contact ideal: " + string(cont)); }
quit;
