matrix A = transpose(matrix(N, 15, ncols(N)));
module Z = syz(A);
int i; int j; int found = 0;
for (i = 1; i <= ncols(Z); i++) { if (found == 0 && Z[i][15] == 1) {
  found = 1; for (j = 1; j <= 15; j++) { print("EXIST " + string(j - 1) + " " + string(Z[i][j])); } } }
module E = gen(15);
module I = intersect(N, E);
for (i = 1; i <= ncols(I); i++) { if (found == 0 && I[i][15] != 0) {
  print("NONEX " + string(i) + " " + string(I[i][15]));
  matrix T = lift(N, module(I[i]));
  for (j = 1; j <= nrows(T); j++) { print("LAMBDA " + string(i) + " " + string(j - 1) + " " + string(T[j, 1])); }
  kill T; } }
if (found == 0 && ncols(I) > 0 && I[1][15] != 0) { found = 2; }
if (found == 0) { print("NONE"); }
quit;
