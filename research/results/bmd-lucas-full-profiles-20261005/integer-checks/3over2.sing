W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=9;j++){R[1,j]=F3[5,j];}
for(h=5;h<=7;h++){cf=subst(W/t^(h-5),t,0);for(j=1;j<=9;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
W=0;for(k=0;k<=7;k++){W=W+bc(0,k)*(-ss*t+t^2)^k;}
W=(1+t)^1*(1-t)^3*W;
for(j=1;j<=9;j++){R[1,j]=F3[6,j];}
for(h=6;h<=7;h++){cf=subst(W/t^(h-6),t,0);for(j=1;j<=9;j++){F3[h,j]=F3[h,j]-cf*R[1,j];}}
for(j=1;j<=9;j++){D[9,j]=F3[7,j];}
print("dimension=9; maximum high depth=12");
poly detD=det(D);
poly AA=(1)*u^0+(-190)*u^2+(4845)*u^4+(-38760)*u^6+(125970)*u^8+(-184756)*u^10+(125970)*u^12+(-38760)*u^14+(4845)*u^16+(-190)*u^18+(1)*u^20;poly BB=(20)*u^1+(-1140)*u^3+(15504)*u^5+(-77520)*u^7+(167960)*u^9+(-167960)*u^11+(77520)*u^13+(-15504)*u^15+(1140)*u^17+(-20)*u^19;poly GG=(1)*u^0+(190)*u^2+(4845)*u^4+(38760)*u^6+(125970)*u^8+(184756)*u^10+(125970)*u^12+(38760)*u^14+(4845)*u^16+(190)*u^18+(1)*u^20;poly HH=(-20)*u^1+(-1140)*u^3+(-15504)*u^5+(-77520)*u^7+(-167960)*u^9+(-167960)*u^11+(-77520)*u^13+(-15504)*u^15+(-1140)*u^17+(-20)*u^19;
map shift=rr,t,u^(20)*C,(AA*X+BB*Y)/(1),(AA*Y-BB*X)/(1),(GG*U+HH*V)/(1),(HH*U+GG*V)/(1);
detD=shift(detD);
print("case 3over2");

if(detD==0){ERROR("zero determinant");}
list fac=factorize(detD);
poly product=1;int ff;
for(ff=1;ff<=size(fac[1]);ff++){product=product*fac[1][ff]^fac[2][ff];}
if(product!=detD){ERROR("factor product mismatch");}
