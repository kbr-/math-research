// Rank witness after actual powers: the constant-c factor contains a controlled Frobenius sum.
ring rr=(7,u),(t,c,x,y),dp;
execute(read("research/results/bmd-eight-septenary-variation-20261006/boundary-data.sing"));
poly Phi=(u^5/(u^2+1))*(LeftKernel[1,1]/c);
if((u^2+1)/u^5*c*Phi!=LeftKernel[1,1]){ERROR("exact cofactor factor extraction");}
poly expected=u^3*((u-1)*x+(u+1)*y)*(u*x+y);
if(subst(Phi,c,0)!=expected){ERROR("rank constant-c factor identity");}
if(CofactorFactor!=c*(u^6*c+1)){ERROR("cofactor common factor");}
print("PASS first minor=(u2+1)/u5*c2*(1+u6*c)*Phi; Phi_c0=u3*((u-1)X+(u+1)Y)*(uX+Y).");
print("Actual uX+Y=(u2+1)*((u-i)^(N-1)+(u+i)^(N-1)).");
print("q=7^valuation_7(N-1); N divisible16 excludes N-1=7^e, since7^e is1or7mod16.");
print("Thus q<=(N-1)/3 and constant-c orderq+3<N; positive-c terms start at leastN.");
quit;
