// Third full survivor source (v,v^2,w^7,vw^7)*F_(2c+1), c=5 mod9,p3.
// Seven finite and six high constraints. All local indices<=5; N=M=3 mod9.
ring rr=(3,u),(t,C,X,Y),dp;
proc bc(int n,int k){
 int residue=n%9;if(residue<0){residue=residue+9;}
 poly P=(1+t)^residue;return(subst(P/t^k,t,0));
}
matrix D[13][13];int j,k,h,a,row,sg,r;poly val;
row=0;
for(sg=0;sg<=1;sg++){
 a=1-2*sg;
 for(h=1;h<=5;h=h+2){
  row++;
  for(j=0;j<=12;j++){
   val=0;
   for(k=0;k<=h;k++){
    val=val+bc(3,k)*(a-u)^(h-k)
     *(a^k*bc(j-3,h-k)-(-u)^k*bc(-j,h-k));
   }
   D[row,j+1]=a^(j+h)*val;
  }
 }
}
row++;
for(j=0;j<=12;j++){
 if(j%4==0){D[row,j+1]=X;}
 if(j%4==1){D[row,j+1]=Y;}
 if(j%4==2){D[row,j+1]=-X;}
 if(j%4==3){D[row,j+1]=-Y;}
}
for(r=0;r<=5;r++){
 row++;
 for(j=0;j<=12;j++){
  k=r-12+j;if(k>=0){D[row,j+1]=bc(3,k)*(-u)^k;}
  k=r-j;if(k>=0){D[row,j+1]=D[row,j+1]+C*bc(3,k)*(-u)^(-k);}
 }
}
if(row!=13){ERROR("condition count");}
poly detD=det(D);
print("third survivor determinant:");
print(factorize(detD));
poly expected=(u^6-1)/u^9*(C+u^3)*(C-u^3)
 *(-u^3*C*X+C*Y+u^3*X+u^6*Y)*(u^6*C+1)^3;
if(detD!=expected){ERROR("factor identity mismatch");}
else{print("PASS: exact determinant identity");}
quit;
