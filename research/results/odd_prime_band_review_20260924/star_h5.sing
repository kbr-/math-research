// Route-review falsification test of thm:star-degree-locality (unconditional at h = 5): a four-block star at h = 5.
// A fall below 9 would contradict the theorem, since linked pairs with R at h = 5 fall first at 9 (r_added_pair_h5.out)
// and the theorem allows the family to fall at degree <= 11 only where a subfamily of at most three blocks falls.  Over F_3: four separately augmented complete accuracy-one ENS
// blocks with h = 5 inputs, private coefficients: a on (x, ya2..ya5), b on (x, yb2..yb5), c on (x+1, ...), d on (x+2, ...).
// Cross set by the rule of conj:bounded-linkage-large-h: R for the parallel pairs ac, ad, bc, bd, cd; T for the
// triples covering the three translates, acd and bcd.  Field equations for all variables.
// Output: lowest degree t < DB of an element of (J:z) not in J (DB if none), for the whole family.  DB = 9: falls at
// degree <= 8 are visible.  Prediction stated before the run: no fall below 9.
option(redSB);
ring S = 3, (x, ya(2..5), yb(2..5), yc(2..5), yd(2..5), ra(1..5), rb(1..5), rc(1..5), rd(1..5), z), dp;
proc blockP(ideal L, ideal rr)
{
  poly P = 1; int i;
  for (i = 1; i <= 5; i++) { P = P - rr[i]*(1 - L[i]^2); }
  return(P);
}
proc blockI(ideal L, poly P)
{
  ideal I; int i;
  for (i = 1; i <= 5; i++) { I = I, (1 - L[i]^2)*P; }
  return(I);
}
ideal La = x, ya(2), ya(3), ya(4), ya(5);      ideal Ra = ra(1..5);
ideal Lb = x, yb(2), yb(3), yb(4), yb(5);      ideal Rb = rb(1..5);
ideal Lc = x + 1, yc(2), yc(3), yc(4), yc(5);  ideal Rc = rc(1..5);
ideal Ld = x + 2, yd(2), yd(3), yd(4), yd(5);  ideal Rd = rd(1..5);
poly Pa = blockP(La, Ra); poly Pb = blockP(Lb, Rb); poly Pc = blockP(Lc, Rc); poly Pd = blockP(Ld, Rd);
ideal F; int i;
for (i = 1; i <= nvars(basering) - 1; i++) { F = F, var(i)^3 - var(i); }
ideal Ga = std(blockI(La, Pa) + F); ideal Gb = std(blockI(Lb, Pb) + F);
ideal Gc = std(blockI(Lc, Pc) + F); ideal Gd = std(blockI(Ld, Pd) + F);
poly qa = 1 - La[1]^2; poly qb = 1 - Lb[1]^2; poly qc = 1 - Lc[1]^2; poly qd = 1 - Ld[1]^2;
ideal Cross = Pa*Pc*(qa - qc), Pa*Pd*(qa - qd), Pb*Pc*(qb - qc), Pb*Pd*(qb - qd), Pc*Pd*(qc - qd), Pa*Pc*Pd, Pb*Pc*Pd;
proc lowestfall(ideal J, int DB)
{
  degBound = DB; ideal SJ = std(J); ideal Q = quotient(SJ, z); degBound = 0;
  int lowest = DB; int k;
  for (k = 1; k <= ncols(Q); k++) { if (Q[k] != 0 && deg(Q[k]) < lowest) { if (reduce(Q[k], SJ) != 0) { lowest = deg(Q[k]); } } }
  return(lowest);
}
int DB = 9;
ideal Jab = homog(F, z) + homog(Ga, z) + homog(Gb, z);
ideal Jall = Jab + homog(Gc, z) + homog(Gd, z) + homog(Cross, z);
print("SUB abcd DB=" + string(DB) + " lowest_fall=" + string(lowestfall(Jall, DB)));
quit;
