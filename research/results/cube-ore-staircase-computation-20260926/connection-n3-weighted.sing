// Generated exact weighted symmetric connection, n=3, d=2.
LIB "nctools.lib";
ring comm=0,(D,e_1,e_2,e_3),(lp(1),wp(1,2,3));
matrix corrections[4][4];
corrections[1,2]=e_1^2-2*e_2;
corrections[1,3]=e_1*e_2-3*e_3;
corrections[1,4]=e_1*e_3;
def ore=nc_algebra(1,corrections); setring ore;
option(redSB); option(redTail);
int cubeN=3; int connectionRank=8;
intvec parameterWeights=1,2,3;
