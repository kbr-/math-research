// Correct nine-condition exceptional third merge in characteristic seven.
ring rr=7,(u,v,Z,S,T,C,X,Y),dp;
matrix M[9][9];matrix H[5][9];matrix L[5][9];
list beta=1,8,28,56,70;
int j,k,col;
for(j=0;j<=8;j++)
{
 M[1,j+1]=j+(8-j)*u;
 M[2,j+1]=(-1)^j*(-j+(8-j)*u);
 if(j%4==0){M[3,j+1]=X;}
 if(j%4==1){M[3,j+1]=Y;}
 if(j%4==2){M[3,j+1]=-X;}
 if(j%4==3){M[3,j+1]=-Y;}
}
for(j=0;j<=4;j++)
{
 for(k=0;k<=j;k++)
 {
  H[j+1,9-j+k]=(-1)^k*beta[k+1]*u^k;
  L[j+1,j-k+1]=C*(-1)^k*beta[k+1]*u^(j-k);
 }
}
for(col=1;col<=9;col++)
{
 M[4,col]=H[1,col]+L[1,col];
 M[5,col]=H[2,col];
 M[6,col]=L[2,col];
 M[7,col]=u^2*H[3,col]-L[3,col]+6*u^2*(H[1,col]-L[1,col]);
 M[8,col]=u^3*H[4,col]+L[4,col];
 M[9,col]=u^4*H[5,col]+L[5,col]+2*u^4*H[3,col]+2*u^2*L[3,col];
}
poly D=det(M);
poly E=subst(subst(subst(D,C,u*Z),X,u*S-T),Y,u*T+S);
ideal rel=u^7-v;
E=reduce(E,std(rel));
poly expected=(u^3+u^5)*v*Z*(v*Z+1)*((2-3*Z^2)*S+Z*(2*Z^2-3)*T);
if(E-expected!=0){ERROR("Frobenius coefficient factorization failed");}
print("PASS: reduced determinant factorization");print(expected);
print("After Z=v^k, k=(N-1)/7=32(d/7)-7 >=25, divide the nonzero common factors.");
print("At v=i, k=1 mod4: residual = 3*(2*i)^k, nonzero in characteristic seven.");
quit;
