ideal GB = std(I);
ideal GA = std(I + ideal(z));
string sb = "HFB {"; string sa = "HFA {"; int t;
for (t = 0; t <= 3; t++) { if (t > 0) { sb = sb + ","; sa = sa + ","; } sb = sb + string(size(kbase(GB, t))); sa = sa + string(size(kbase(GA, t))); }
print(sb + "}"); print(sa + "}");
quit;
