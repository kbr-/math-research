option(redSB);
ring r = 2, (y1, y2, B), dp;
module N = [1, 0];
matrix A = transpose(matrix(N, 2, ncols(N)));
module Z = syz(A);
int i; int j; int found = 0;
for (i = 1; i <= ncols(Z); i++) { if (found == 0 && Z[i][2] == 1) {
  found = 1; for (j = 1; j <= 2; j++) { print("EXIST " + string(j - 1) + " " + string(Z[i][j])); } } }
module E = gen(2);
module I = intersect(N, E);
for (i = 1; i <= ncols(I); i++) { if (found == 0 && I[i][2] != 0 && diff(I[i][2], B) == 0) {
  found = 2; print("NONEX " + string(I[i][2]));
  matrix T = lift(N, module(I[i]));
  for (j = 1; j <= nrows(T); j++) { print("LAMBDA " + string(j - 1) + " " + string(T[j, 1])); } } }
if (found == 0) { print("NONE"); }
quit;
