// Fall witnesses of the plane pair P1 (a on (x, y, ya(1)), b on (x+y, x-y, yb(1)), h = 3, private coefficients,
// separately augmented, no cross generators), which falls at 5 (pair_overlap.out).  Prints the elements of (J:z)
// of degree 5 not in J, reduced modulo J, with z set to 1, to identify the consequence that falls.
option(redSB);
ring S = 3, (x, y, w, ya(1), yb(1), ra(1..3), rb(1..3), z), dp;
ideal La = x, y, ya(1); ideal Lb = x + y, x - y, yb(1);
int i; poly Pa = 1; poly Pb = 1;
for (i = 1; i <= 3; i++) { Pa = Pa - ra(i)*(1 - La[i]^2); Pb = Pb - rb(i)*(1 - Lb[i]^2); }
ideal F; for (i = 1; i <= nvars(basering) - 1; i++) { F = F, var(i)^3 - var(i); }
ideal Ia; ideal Ib; for (i = 1; i <= 3; i++) { Ia = Ia, (1 - La[i]^2)*Pa; Ib = Ib, (1 - Lb[i]^2)*Pb; }
ideal J = homog(F, z) + homog(std(Ia + F), z) + homog(std(Ib + F), z);
degBound = 7; ideal SJ = std(J); ideal Q = quotient(SJ, z); degBound = 0;
int k; int n = 0; poly g;
for (k = 1; k <= ncols(Q); k++) { if (Q[k] != 0 && deg(Q[k]) == 5) { g = reduce(Q[k], SJ); if (g != 0 && n < 6) { n++; print("witness " + string(n) + ": " + string(subst(g, z, 1))); } } }
print("witnesses of degree 5 printed: " + string(n));
quit;
