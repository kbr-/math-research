// The remaining D42mod49 scalar is nonzero by the same controlled Frobenius sum as the rank witness.
ring rr=(7,u),(t,c,x,y),dp;
execute(read("research/results/bmd-eight-septenary-variation-20261006/boundary-data.sing"));
execute(read("research/results/bmd-eight-septenary-variation-20261006/state-42.sing"));
poly factor0=(u^2+1)/u^6*c*(c^2-u^2);list dv=division(RepairScalar,factor0);poly P=dv[1][1,1];
if(P*factor0!=RepairScalar){ERROR("exact delayed scalar factor");}
poly expected=u^4*(u^2+1)*(u*x+y)*(-x+u*y);
if(subst(P,c,0)!=expected){ERROR("delayed constant-c identity");}
poly Phi=u^5/(u^2+1)*(LeftKernel[1,1]/c);
if((u^2+1)/u^5*c*Phi!=LeftKernel[1,1]){ERROR("rank factor extraction");}
if(subst(Phi,c,0)!=u^3*((u-1)*x+(u+1)*y)*(u*x+y)){ERROR("rank constant-c identity");}
string ep=string(P);string ef=string(Phi);
ring polynomialRing=7,(u,t,c,x,y),dp;
execute("poly pAudit="+ep+";");execute("poly fAudit="+ef+";");
if(diff(pAudit,t)!=0 || diff(fAudit,t)!=0){ERROR("unexpected tail variable");}
string bp=string(pAudit);string bf=string(fAudit);
setring rr;execute("poly pBack="+bp+";");execute("poly fBack="+bf+";");
if(pBack!=P || fBack!=Phi){ERROR("nonnegative-u polynomial roundtrip");}
print("PASS delayed scalar=(u2+1)/u6*c*(c2-u2)*P, P_c0=u4*(u2+1)*(uX+Y)*(-X+uY).");
print("PASS P and rank Phi are polynomials with no negative u powers.");
print("q=7^valuation_7(N-1)<=(N-1)/3 because N divisible16 excludes a pure7-power N-1.");
print("P constant-c order=q+4<N; its positive-c terms start atN. All outer factors are actual nonzero.");
quit;
