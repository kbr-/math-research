\\ Independent full-polynomial extraction for both residue-two sources.
default(parisizemax,1000000000);
default(nbthreads,1);
ep='ep;b='b;T='T;x='x;
assert(c,msg)=if(!c,print("FAIL ",msg);quit(1));
{for(stage=1,2,my(p=23,s=23*stage,gdeg=if(stage==1,3,1),C=s+if(stage==1,8,7),g=if(stage==1,(1+T)*(1+2*T)^2,1+T),G=g*(1+ep*T)^(gdeg+1),emax=2*s+14,odd=2*gdeg+1,o=Mod(1,p),A=matrix(gdeg,gdeg,i,j,o*polcoef((x-1)^(emax+j),2*i-1,x)),Vs=if(stage==1,[1,G,T*G],concat([1],vector(5,j,T^(j-1)*G))),width=C-s+1,span=#Vs,Q=matrix(width,span,i,j,polcoef(Vs[j],i-1,T)),low=Q[1..span,],dlo=matdet(low),adj=dlo*low^-1,ncut=width-span);read(concat("research/results/bmd-elliptic-second-residue-20261009/",if(stage==1,"constraints.gp","second-constraints.gp")));my(expected=o*subst(R,b,2),actual=matrix(2*ncut,32));for(h=0,31,my(e=emax-h,al=-A^-1*vector(gdeg,i,o*polcoef((x-1)^e,2*i-1,x))~,f=o*(x-1)^e+sum(j=1,gdeg,al[j]*(x-1)^(emax+j)),ev=sum(j=0,C,polcoef(f,2*j,x)*(1+ep*T)^j),od=g*sum(j=0,C-gdeg,polcoef(f,odd+2*j,x)*(1+ep*T)^j));for(i=1,gdeg,assert(polcoef(f,2*i-1,x)==0,"exact omitted odd source coefficient"));for(which=1,2,my(F=if(which==1,ev,od),fac=o*2^(14-h)*ep^(h-s+if(which==1,0,gdeg)));for(j=span,width-1,actual[(which-1)*ncut+j-span+1,h+1]=fac*(dlo*polcoef(F,s+j,T)-sum(k=1,span,sum(l=1,span,Q[j+1,l]*adj[l,k])*polcoef(F,s+k-1,T))))));assert(actual==expected,"every complete source equation matches bounded encoding");print("DIRECT_SOURCE stage=",stage," positive_parameter=",s," field=23 equations=",2*ncut*32," all_pass=true"));}
print("COMPLETE both independent full-polynomial source controls.");
quit;
