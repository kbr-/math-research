// CONTROL for three_local_db11_slim.sing (same families, degree bound 11, slimgb): augment each four-block family
// by its own consequences derivable within degree 11 and read the lowest fall.  Decides whether the fall at 9 after
// three-local augmentation is a four-block phenomenon (control has no fall below 11) or an artifact of augmenting
// by degree-bounded consequences (control also falls below 11).
// Three-local joint augmentation test (the natural general form of open statement S2): for a four-block family of
// separately augmented complete accuracy-one ENS blocks over F_3 with private coefficients, h = 3 inputs (two shared,
// one private), add for every subfamily T of three blocks all of T's consequences derivable within degree 11
// (S_T in degree s = elements f with z^(11-s) f in J_T), then compute the family's lowest fall below 11.
// This version uses slimgb for every basis and degree bound 11 for both families.
// three_local_db9_slim.out: at degree bound 9 the cycle family still falls at 8 after three-local augmentation.
// It used degree bound 9 (consequences derivable within degree 9, falls at degree <= 8 visible).
// Question decided: does jointly augmenting every subfamily of at most three blocks remove every fall of the family
// below 11?  A remaining fall means a four-block phenomenon, so members must grow beyond three blocks.
// Families:  cycle:  a (x, y), b (x+y, w), c (w, v), d (v, x-y)
//            plane4: a (x, y), b (x+y, x-y), c (x, x+y), d (y, x-y)
// Output: the family's lowest fall after three-local augmentation (three_local_timeout.out: the cycle family's own
// lowest fall without cross generators is 7).
option(redSB);
int DBG = 11;  // degree bound 11, the compiler degree: falls at degree <= 10 visible
system("--ticks-per-sec", 1); int t0 = rtimer;
proc blockideal(ideal L, ideal rr)
{
  poly P = 1; int i; for (i = 1; i <= 3; i++) { P = P - rr[i]*(1 - L[i]^2); }
  ideal I; for (i = 1; i <= 3; i++) { I = I, (1 - L[i]^2)*P; }
  return(I);
}
proc lowestfall(ideal J, int DB)
{
  // Lowest fall below DB without a second standard basis: by Bayer's theorem (dp, z last), (J : z) is generated by
  // J and g/z for the standard basis elements g divisible by z; the least degree of such a g/z not in J is the fall.
  degBound = DB; ideal SJ = slimgb(J); degBound = 0;
  int lowest = DB; int k; poly g;
  for (k = 1; k <= ncols(SJ); k++) {
    g = SJ[k];
    if (g != 0 && subst(g, z, 0) == 0) { g = g / z; if (deg(g) < lowest) { if (reduce(g, SJ) != 0) { lowest = deg(g); } } }
  }
  return(lowest);
}
proc derivable(ideal J, int DB)
{
  // Consequences derivable within degree DB: by Bayer's theorem, for dp (degree reverse lexicographic) with z the
  // last variable, dividing each element of a degree-DB-truncated standard basis by its highest power of z gives
  // generators of all f with z^m f in J_(<= DB).  One standard basis instead of one colon per degree.
  degBound = DB; ideal SJ = slimgb(J); degBound = 0;
  ideal S; int k; poly g; int m;
  for (k = 1; k <= ncols(SJ); k++) {
    g = SJ[k]; m = 0;
    while (g != 0 && subst(g, z, 0) == 0) { g = g / z; m++; }
    if (m > 0) { S = S, g; }
  }
  return(S);
}
proc runfamily(int kind)
{
  ring S = 3, (x, y, w, v, p(1..4), r(1..12), z), dp;
  list L;
  if (kind == 1) { L = ideal(x, y, p(1)), ideal(x + y, w, p(2)), ideal(w, v, p(3)), ideal(v, x - y, p(4)); }
  else { L = ideal(x, y, p(1)), ideal(x + y, x - y, p(2)), ideal(x, x + y, p(3)), ideal(y, x - y, p(4)); }
  ideal F; int i; for (i = 1; i <= nvars(basering) - 1; i++) { F = F, var(i)^3 - var(i); }
  list G; ideal rr; int j;
  for (j = 1; j <= 4; j++) { rr = r(3*j-2), r(3*j-1), r(3*j); G = G + list(homog(std(blockideal(L[j], rr) + F), z)); }
  ideal J = homog(F, z) + G[1] + G[2] + G[3] + G[4];
  string nm = "cycle"; if (kind == 2) { nm = "plane4"; }
  degBound = DBG; ideal SJ = slimgb(J); degBound = 0;
  print(nm + " family standard basis: " + string(ncols(SJ)) + " elements, " + string(rtimer - t0) + " s");
  // Control: augment the family by its OWN consequences derivable within degree DBG (Bayer, from SJ), then read
  // the lowest fall.  If this still falls below DBG, falls after augmentation are an artifact of the formulation
  // (the ideal generated by degree-bounded consequences is not closed under the cutoff), not of locality.
  ideal New; int k; poly g;
  for (k = 1; k <= ncols(SJ); k++) { g = SJ[k]; if (g != 0 && subst(g, z, 0) == 0) { while (subst(g, z, 0) == 0) { g = g / z; } New = New, g; } }
  degBound = DBG; ideal SA = slimgb(SJ + New); degBound = 0;
  print(nm + " self-augmented basis (slimgb): " + string(ncols(SA)) + " elements, " + string(rtimer - t0) + " s");
  int lowest = DBG;
  for (k = 1; k <= ncols(SA); k++) { g = SA[k]; if (g != 0 && subst(g, z, 0) == 0) { g = g / z; if (deg(g) < lowest) { if (reduce(g, SA) != 0) { lowest = deg(g); } } } }
  print(nm + " self-augmentation control: lowest_fall=" + string(lowest) + ", " + string(rtimer - t0) + " s");
}
runfamily(1);
runfamily(2);
quit;
