// Open statement A1 (adversarial forms), product-clause form of W, at full member closure.
// A clause block b has affine forms L_{b,1..h}, a set S_b, and the axioms (1 - L_{b,i}^2) * prod_{j in S_b} L_{b,j}^2
// for i not in S_b (the partial-prefix images of thm:logarithmic-prefix-wide-clause-reduction at p = 3).
// For a subfamily T let I(T) be the ideal of its axioms plus the field equations v^3 - v of all variables: over F_3
// this is the ideal of all functions vanishing on T's zero set (the full closure, W's budget exceeds the members' spans).
// Statement tested (t-locality): the homogenized ideal of the whole family equals the ideal generated by the field
// equations and the homogenizations of I(T) over all T with |T| = t, i.e. every consequence of degree s is derived at
// degree s from consequences of t-block subfamilies.  Since the dehomogenized ideals agree, t-locality holds iff the
// generated ideal J is z-saturated; the output is the lowest degree of an element of (J : z) not in J (-1 if none).
//   P4:  plane4 clauses, hub (x,y), S-pairs (x,y), (x+y,x-y), (x,x+y), (y,x-y), one private outside input u_b each.
//   P4w: the same with two private outside inputs u_b, w_b per block.
//   P6:  all six pairs of the four lines of the plane, one private outside input each.
//   H3:  hub (x,y,v): eight blocks whose S-pairs are pairs of lines of F_3^3, one private outside input each.
// This third script (clause_points) tests a covering-type configuration: width-4 blocks in the plane whose product Q_b is
// the indicator of a single point w_b (forms: two lines through the other points' complement), one private input each.
//   PT6: the six points with x != 0.  Candidate consequence x * prod_b (1 - u_b^2), degree 13, needs all six blocks.
//   PT8: all eight nonzero points.
option(redSB);
system("--ticks-per-sec", 1); int t0 = rtimer;
proc lowestfall(ideal J)
{
  ideal SJ = std(J); ideal Q = quotient(SJ, z); ideal R = simplify(reduce(Q, SJ), 2);
  int lowest = -1; int k;
  for (k = 1; k <= ncols(R); k++) { if (R[k] != 0) { if (lowest < 0 || deg(R[k]) < lowest) { lowest = deg(R[k]); } } }
  return(lowest);
}
proc subsets(int m, int t)
{
  list out; int c; int i; int cnt; intvec v;
  for (c = 0; c < 2^m; c++) {
    cnt = 0; v = 0;
    for (i = 1; i <= m; i++) { if ((c div 2^(i-1)) mod 2 == 1) { cnt++; if (cnt == 1) { v = i; } else { v = v, i; } } }
    if (cnt == t) { out = out + list(v); }
  }
  return(out);
}
proc runfamily(string nm, list SF, list OF, int m)
{
  // SF[b]: the S-forms of block b; OF[b]: its outside forms.  Returns nothing; prints lowest fall for t = 1..m.
  ideal F; int i; for (i = 1; i <= nvars(basering) - 1; i++) { F = F, var(i)^3 - var(i); }
  list AX; int b; poly Q; ideal A;
  for (b = 1; b <= m; b++) {
    Q = 1; for (i = 1; i <= ncols(SF[b]); i++) { Q = Q * SF[b][i]^2; }
    A = 0; for (i = 1; i <= ncols(OF[b]); i++) { A = A, (1 - OF[b][i]^2) * Q; }
    AX = AX + list(A);
  }
  int t; list SS; int s; ideal IT; ideal J; int j; int md;
  for (t = 1; t <= m; t++) {
    SS = subsets(m, t); J = homog(F, z); md = 0;
    for (s = 1; s <= size(SS); s++) {
      IT = F; for (j = 1; j <= size(SS[s]); j++) { IT = IT + AX[SS[s][j]]; }
      IT = std(IT);
      for (i = 1; i <= ncols(IT); i++) { if (deg(IT[i]) > md) { md = deg(IT[i]); } }
      J = J + homog(IT, z);
    }
    print(nm + ": t = " + string(t) + ", subsets " + string(size(SS)) + ", max member basis degree " + string(md) + ", lowest_fall=" + string(lowestfall(J)) + ", " + string(rtimer - t0) + " s");
  }
}

proc ptforms(int a, int b)
{
  return(ideal(x - a - 1, x - a + 1, y - b - 1, y - b + 1));
}
ring S1 = 3, (x, y, u(1..8), z), dp;
list P6 = ptforms(1,0), ptforms(1,1), ptforms(1,-1), ptforms(-1,0), ptforms(-1,1), ptforms(-1,-1);
runfamily("PT6", P6, list(ideal(u(1)), ideal(u(2)), ideal(u(3)), ideal(u(4)), ideal(u(5)), ideal(u(6))), 6);
list P8 = P6 + list(ptforms(0,1), ptforms(0,-1));
runfamily("PT8", P8, list(ideal(u(1)), ideal(u(2)), ideal(u(3)), ideal(u(4)), ideal(u(5)), ideal(u(6)), ideal(u(7)), ideal(u(8))), 8);
quit;
