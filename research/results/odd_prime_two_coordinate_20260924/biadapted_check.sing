// Necessary conditions for a bi-adapted basis of one block that reads two shared coordinates x, y: a basis e_i of
// its truncated algebra A over S = F_3[x,y]/(x^3,y^3) with each member M of Sigma equal to sum_i J_i(M) e_i for
// monomial ideals J_i(M) of S.  In such a basis every colon (M : x^a y^b) is again of this form, so:
// (i) reduction phi(I) = I + (x,y)A commutes with intersections of colons (tested on all pairs and triples), and
// (ii) the reductions phi(colon) generate a distributive lattice (closure under + and cap, all triples tested).
// Block: complete accuracy-one ENS, inputs x, y (shared), yp(3..h) private, coefficients r(1..h); tops of the
// reduced dp basis in F_3[vars]/(all cubes).  Families: model = {rho'Q, rho'A}, full = {n, rho'A}.
option(redSB);
proc eqideal(ideal I1, ideal I2)
{
  ideal S1 = std(I1); ideal S2 = std(I2); int k;
  for (k = 1; k <= ncols(I1); k++) { if (reduce(I1[k], S2) != 0) { return(0); } }
  for (k = 1; k <= ncols(I2); k++) { if (reduce(I2[k], S1) != 0) { return(0); } }
  return(1);
}
proc findin(list Lst, ideal J)
{
  int k; for (k = 1; k <= size(Lst); k++) { if (eqideal(Lst[k], J) == 1) { return(k); } }
  return(0);
}
proc brun(int h, int model)
{
  ring P = 3, (x, y, yp(3..h), r(1..h)), dp;
  ideal L = x, y; int i; for (i = 3; i <= h; i++) { L = L, yp(i); }
  poly Pp = 1; for (i = 1; i <= h; i++) { Pp = Pp - r(i)*(1 - L[i]^2); }
  ideal I; for (i = 1; i <= h; i++) { I = I, (1 - L[i]^2)*Pp; }
  for (i = 1; i <= nvars(P); i++) { I = I, var(i)^3 - var(i); }
  ideal G = std(I); ideal Tp; int d; poly g;
  for (i = 1; i <= ncols(G); i++) { g = G[i]; d = deg(g); Tp = Tp, jet(g, d) - jet(g, d - 1); }
  poly rho = 0; for (i = 1; i <= h; i++) { rho = rho + r(i)*L[i]^2; }
  ideal Qm; for (i = 1; i <= h; i++) { Qm = Qm, L[i]^2; }
  ideal Cubes; for (i = 1; i <= nvars(P); i++) { Cubes = Cubes, var(i)^3; }
  qring Q = std(Cubes);
  ideal Tp = fetch(P, Tp); poly rho = fetch(P, rho); ideal Qm = fetch(P, Qm);
  list Sig;
  if (model == 1) { Sig = std(rho*Qm), std(ideal(rho)); } else { Sig = std(Tp), std(ideal(rho)); }
  list C; int a; int b; ideal cand;
  for (i = 1; i <= size(Sig); i++) { for (a = 0; a <= 2; a++) { for (b = 0; b <= 2; b++) {
    if (a + b == 0) { cand = Sig[i]; } else { cand = std(quotient(Sig[i], ideal(x^a*y^b))); }
    if (findin(C, cand) == 0) { C = C + list(cand); }
  } } }
  int nc = size(C); ideal XY = std(ideal(x, y));
  int t1 = 0; int f1 = 0; int c;
  for (a = 1; a <= nc; a++) { for (b = a + 1; b <= nc; b++) {
    t1++; if (eqideal(intersect(C[a], C[b]) + XY, intersect(C[a] + XY, C[b] + XY)) == 0) { f1++; }
    for (c = b + 1; c <= nc; c++) {
      t1++; if (eqideal(intersect(C[a], C[b], C[c]) + XY, intersect(C[a] + XY, C[b] + XY, C[c] + XY)) == 0) { f1++; }
    }
  } }
  print("h=" + string(h) + " model=" + string(model) + " colons=" + string(nc) + " (i) pairs+triples tested=" + string(t1) + " failed=" + string(f1));
  list Lat; for (i = 1; i <= nc; i++) { cand = std(C[i] + XY); if (findin(Lat, cand) == 0) { Lat = Lat + list(cand); } }
  int changed = 1; int cap = 200;
  while (changed == 1 && size(Lat) <= cap) {
    changed = 0; int m0 = size(Lat);
    for (a = 1; a <= m0; a++) { for (b = a + 1; b <= m0; b++) {
      cand = std(Lat[a] + Lat[b]); if (findin(Lat, cand) == 0) { Lat = Lat + list(cand); changed = 1; }
      cand = std(intersect(Lat[a], Lat[b])); if (findin(Lat, cand) == 0) { Lat = Lat + list(cand); changed = 1; }
    } }
    kill m0;
  }
  int m = size(Lat); int t2 = 0; int f2 = 0;
  if (m <= cap) {
    for (a = 1; a <= m; a++) { for (b = 1; b <= m; b++) { for (c = b + 1; c <= m; c++) {
      t2++; if (eqideal(intersect(Lat[a], Lat[b] + Lat[c]), intersect(Lat[a], Lat[b]) + intersect(Lat[a], Lat[c])) == 0) { f2++; }
    } } }
    print("h=" + string(h) + " model=" + string(model) + " (ii) closure=" + string(m) + " triples=" + string(t2) + " failed=" + string(f2));
  } else { print("h=" + string(h) + " model=" + string(model) + " (ii) closure exceeded cap"); }
}
brun(3, 1); brun(3, 0); brun(4, 1); brun(4, 0);
quit;
