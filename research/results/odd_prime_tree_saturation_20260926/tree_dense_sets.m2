-- Tree saturation for arbitrary cylinder sets (falsification test of a general tree lemma).
-- R = F_3[z]/(z^3 - z); member b is a cylinder set P_b = {z : z_{V_b} in A_b}, A_b a random
-- subset of F_3^{V_b} of density about 1/2, J_b = I(P_b) generated by indicators of excluded
-- points plus z^3 - z. Statement tested: for a chain V_1, V_2, V_3 with V_1 cap V_3 inside V_2,
-- gr(J_1+J_2+J_3) = gr(J_1+J_2) + gr(J_2+J_3), now for dense members (densities 0.9, 0.97), as the
-- density hypothesis for the randomized-prefix chains. Also a triangle control. Reports excess degrees.
kk = ZZ/3;
out = openOut getenv "TR_OUT";
grIdeal = I -> ideal apply(flatten entries gens gb I, f -> part(first degree f, f));
randomMember = (S, V, dens) -> (
    Z := gens S;
    pts := toList((#V:0)..(#V:2));
    excl := select(pts, p -> random(1.0) > dens);
    ideal(apply(excl, p -> product(#V, k -> 1 - (Z#(V#k) - p#k)^2)) | apply(Z, v -> v^3 - v)));
lenHF = (S, I) -> apply(toList(0..2*numgens S), d -> hilbertFunction(d, S / I));
run1 = (label, S, Vs, edges, DENS) -> (
    Js := apply(Vs, V -> randomMember(S, V, DENS));
    pairSum := sum(edges, e -> grIdeal(Js#(e#0) + Js#(e#1)));
    whole := grIdeal(sum Js);
    a := lenHF(S, pairSum); b := lenHF(S, whole);
    diff := select(#a, d -> a#d != b#d);
    out << label << " density=" << DENS << " len(pairs)=" << sum a << " len(whole)=" << sum b << " fall=" << (a != b)
        << " degrees=" << toString diff << " excess=" << toString(apply(diff, d -> a#d - b#d)) << endl;
    out << flush);
setRandomSeed 20260926;
S4 := kk[z_0..z_3, MonomialOrder => GRevLex];
S7 := kk[z_0..z_6, MonomialOrder => GRevLex];
S6 := kk[z_0..z_5, MonomialOrder => GRevLex];
for dens in {0.9, 0.97} do for trial from 1 to 6 do (
    run1("chain {0,1,2}{2,3,4}{4,5,6}", S7, {{0,1,2},{2,3,4},{4,5,6}}, {{0,1},{1,2}}, dens);
    run1("chain wide separator {0,1,2}{1,2,3}{2,3,4}", S7, {{0,1,2},{1,2,3},{2,3,4}}, {{0,1},{1,2},{0,2}}, dens);
    run1("triangle {0,1,3}{1,2,4}{2,0,5}", S6, {{0,1,3},{1,2,4},{2,0,5}}, {{0,1},{1,2},{0,2}}, dens));
close out;
